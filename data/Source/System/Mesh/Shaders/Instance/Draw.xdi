		<item type="traktor.render.Script" version="8,traktor.render.Node:1">
			<id>{EF3C22BB-6DAD-ED47-B381-BF0850063421}</id>
			<comment/>
			<position>
				<first>429</first>
				<second>277</second>
			</position>
			<name>WriteOut</name>
			<technique>Default</technique>
			<domain>Compute</domain>
			<localSize>
				<X>32</X>
				<Y>1</Y>
				<Z>1</Z>
			</localSize>
			<useRayTracing>false</useRayTracing>
			<include/>
			<inputPins>
				<item>
					<id>{AF60E34F-9E23-4E4B-8874-3FCB33F46C2F}</id>
					<name>DrawBuffer</name>
				</item>
				<item>
					<id>{89D6EAF6-DAAD-C647-B640-7F86B233A509}</id>
					<name>Index</name>
				</item>
				<item>
					<id>{4B89A265-8175-47B0-BCC8-525EE8A0CEC9}</id>
					<name>PartIndex</name>
				</item>
				<item>
					<id>{788C47C3-E973-CF48-9A12-5A2751107996}</id>
					<name>PrimIndexCount</name>
				</item>
				<item>
					<id>{618C459F-DE31-4E4D-A0ED-6D01AF8C87AF}</id>
					<name>PrimFirstIndex</name>
				</item>
			</inputPins>
			<outputPins/>
			<script><![CDATA[

// Write the static half of this part's indirect command. The instance count is
// left at zero; the compaction pass accumulates it with atomics, so this pass
// doubles as the per-frame reset of that counter and must run before it.
const int index = int($Index);
if (index == 0)
{
	const int part = int($PartIndex);

	$DrawBuffer[part].indexCount = int($PrimIndexCount);
	$DrawBuffer[part].instanceCount = 0;
	$DrawBuffer[part].firstIndex = int($PrimFirstIndex);
	$DrawBuffer[part].vertexOffset = 0;
	$DrawBuffer[part].firstInstance = 0;
}
]]></script>
		</item>
