<object type="traktor.render.ShaderGraph" version="traktor.render.Graph:1">
	<nodes>
		<item type="traktor.render.Comment" version="traktor.render.Node:1">
			<id>{3383C44F-8725-4B9B-9B90-5D617234814B}</id>
			<comment><![CDATA[Instance mesh vertex fragment for deformed (world position offset) materials.
Instances holding a deform slot (InstanceMesh_Compact.deform >= 0) read position and last
position from the pooled deform buffers written by the Deform compute technique;
other instances use the vertex stream. Remaining attributes come from the stream.]]></comment>
			<position>
				<first>-1800</first>
				<second>0</second>
			</position>
		</item>
