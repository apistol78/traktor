		<item type="traktor.render.Script" version="8,traktor.render.Node:1">
			<id>{9CD42688-FC93-497C-A8ED-41621E3EB9EB}</id>
			<comment/>
			<position>
				<first>-700</first>
				<second>450</second>
			</position>
			<name>Deform Position</name>
			<technique></technique>
			<domain>Undefined</domain>
			<localSize>
				<X>1</X>
				<Y>1</Y>
				<Z>1</Z>
			</localSize>
			<useRayTracing>false</useRayTracing>
			<include/>
			<inputPins>
				<item>
					<id>{13F960CC-9C21-49A2-8235-88278F1F5F81}</id>
					<name>Slot</name>
				</item>
				<item>
					<id>{CAC7C689-13DC-4335-B500-845BF921AFF6}</id>
					<name>VertexCount</name>
				</item>
				<item>
					<id>{9A3D11D9-7000-4E26-89BE-97E94871C244}</id>
					<name>DeformBuffer</name>
				</item>
				<item>
					<id>{955EE22D-5F3A-42D7-B7A6-63D9CBB9818D}</id>
					<name>DeformBufferLast</name>
				</item>
				<item>
					<id>{ECACE2DF-31AE-414E-9E70-8A500EB325AB}</id>
					<name>StreamPosition</name>
				</item>
			</inputPins>
			<outputPins>
				<item>
					<id>{C2611DE4-9453-4220-862B-47CA6955A1CA}</id>
					<name>Position</name>
					<type>Vector</type>
				</item>
				<item>
					<id>{3BF0625B-0410-4EE9-8F24-A0674E84DF15}</id>
					<name>LastPosition</name>
					<type>Vector</type>
				</item>
			</outputPins>
			<script><![CDATA[
const int slot = int($Slot);
if (slot >= 0)
{
	const int index = slot * int($VertexCount) + gl_VertexIndex;
	$Position = vec4($DeformBuffer[index].Position.xyz, 1.0f);
	$LastPosition = vec4($DeformBufferLast[index].Position.xyz, 1.0f);
}
else
{
	$Position = vec4($StreamPosition.xyz, 1.0f);
	$LastPosition = $Position;
}
			]]></script>
		</item>
