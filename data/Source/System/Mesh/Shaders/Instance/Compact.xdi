		<item type="traktor.render.Script" version="8,traktor.render.Node:1">
			<id>{DA742C50-A24C-4D24-B85D-9FBC49F78860}</id>
			<comment/>
			<position>
				<first>437</first>
				<second>316</second>
			</position>
			<name>Compact</name>
			<technique>Default</technique>
			<domain>Compute</domain>
			<localSize>
				<X>32</X>
				<Y>1</Y>
				<Z>1</Z>
			</localSize>
			<useRayTracing>false</useRayTracing>
			<include/>
			<inputPins>
				<item>
					<id>{89BC9FF3-734F-401B-816E-65A6AB6E95EE}</id>
					<name>DrawBuffer</name>
				</item>
				<item>
					<id>{F190C6A1-C6E8-4D06-8685-2130E0BF27F9}</id>
					<name>CompactBuffer</name>
				</item>
				<item>
					<id>{BAA8DE24-5C73-4586-B40A-89D468928257}</id>
					<name>VisibilityBuffer</name>
				</item>
				<item>
					<id>{3D587CD1-9285-41A1-B62C-2CF2D9575414}</id>
					<name>Index</name>
				</item>
				<item>
					<id>{D55402E6-5D54-4756-B24F-36E64CF788F9}</id>
					<name>InstanceOffset</name>
				</item>
				<item>
					<id>{1DE52FD9-1E3B-45DD-9A07-81D562D5C403}</id>
					<name>InstanceCount</name>
				</item>
				<item>
					<id>{283BC503-0ED5-479C-95DD-75D7F00A5A25}</id>
					<name>PartCount</name>
				</item>
			</inputPins>
			<outputPins/>
			<script><![CDATA[

// Append the visible instances of this batch to a dense list so the batch can be
// drawn with a single indirect command per part instead of one command per
// instance. The vertex shader reads CompactBuffer[gl_InstanceIndex] to recover
// which instance it is drawing.
// InstanceCount is handed over biased by +0.5 so that int() lands on the exact
// value, which means it must be truncated before being compared - comparing the
// int index against the raw float would let index == count through and compact
// the first instance of the *next* batch into this one.
const int index = int($Index);
if (index < int($InstanceCount))
{
	const int offset = int($InstanceOffset);
	if ($VisibilityBuffer[index + offset].visible != 0.0f)
	{
		// Part 0's instance count doubles as the allocation counter; every part
		// draws the same compacted list so they all end up with the same count.
		const int slot = atomicAdd($DrawBuffer[0].instanceCount, 1);
		$CompactBuffer[slot].index = float(index);

		const int partCount = int($PartCount);
		for (int i = 1; i < partCount; ++i)
			atomicAdd($DrawBuffer[i].instanceCount, 1);
	}
}
]]></script>
		</item>
