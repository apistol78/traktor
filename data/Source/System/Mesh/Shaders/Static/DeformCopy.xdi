			<name>Copy</name>
			<technique>Default</technique>
			<domain>Compute</domain>
			<localSize>
				<X>64</X>
				<Y>1</Y>
				<Z>1</Z>
			</localSize>
			<useRayTracing>false</useRayTracing>
			<include/>
			<inputPins>
				<item>
					<id>{46E864A7-F50B-4883-9245-7579EFC332A8}</id>
					<name>Vertices</name>
				</item>
				<item>
					<id>{CC6F69BD-D4CB-40B1-AD52-2E2EFEDE51F8}</id>
					<name>Indices</name>
				</item>
				<item>
					<id>{7111016C-8EEF-4BF3-A125-DADE3C18187D}</id>
					<name>Offset</name>
				</item>
				<item>
					<id>{98846303-0A51-4ACD-8C2C-46877C518517}</id>
					<name>Count</name>
				</item>
				<item>
					<id>{564114D0-B939-4EF4-A816-4D72F79DC8F1}</id>
					<name>Output</name>
				</item>
				<item>
					<id>{659482BB-CCE6-4962-A1E8-2DF9F8AA0A9E}</id>
					<name>OutputOffset</name>
				</item>
			</inputPins>
			<outputPins/>
			<script><![CDATA[
const uint gid = gl_GlobalInvocationID.x;
if (gid < uint($Count))
{
	const int index = $Indices[int($Offset) + int(gid)].Index;
	$Output[index + int($OutputOffset)].Position = vec4($Vertices[index].Position.xyz, 1.0f);
}
			]]></script>
		</item>
