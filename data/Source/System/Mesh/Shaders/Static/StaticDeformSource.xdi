		<item type="traktor.render.Script" version="8,traktor.render.Node:1">
			<id>{B20FB57E-C257-4F84-8378-2E2422435739}</id>
			<comment/>
			<position>
				<first>-1100</first>
				<second>300</second>
			</position>
			<name>Deform Vertex</name>
			<technique></technique>
			<domain>Undefined</domain>
			<localSize>
				<X>1</X>
				<Y>1</Y>
				<Z>1</Z>
			</localSize>
			<useRayTracing>false</useRayTracing>
			<include/>
			<inputPins>
				<item>
					<id>{395195F8-6226-4D0E-AE79-ABFDB614BDBE}</id>
					<name>Vertices</name>
				</item>
				<item>
					<id>{DA6E221A-708C-4E15-BEB7-4D7249B755AD}</id>
					<name>Indices</name>
				</item>
				<item>
					<id>{58FF7254-5EF8-41AC-B617-4A1AC1775549}</id>
					<name>Offset</name>
				</item>
				<item>
					<id>{D6A0D528-ED68-4192-B94A-1FC2755D746A}</id>
					<name>Count</name>
				</item>
				<item>
					<id>{CD536A5E-A842-4B96-A185-E5A281D3A166}</id>
					<name>World</name>
				</item>
				<item>
					<id>{16E6F58D-5D7D-4030-98F4-B86552FD678A}</id>
					<name>View</name>
				</item>
			</inputPins>
			<outputPins>
				<item>
					<id>{FE83C57E-447C-4EC9-8C10-118F84A61802}</id>
					<name>Index</name>
					<type>Scalar</type>
				</item>
				<item>
					<id>{0BDCD4CA-5426-41E9-8E96-BDC7C556F667}</id>
					<name>ObjectPosition</name>
					<type>Vector</type>
				</item>
				<item>
					<id>{2D01A8BE-814F-4FC8-A6BA-B2DE8A5E0187}</id>
					<name>ObjectNormal</name>
					<type>Vector</type>
				</item>
				<item>
					<id>{66DCC21F-0ACA-4FA7-9315-AB0A16370F40}</id>
					<name>ObjectTangent</name>
					<type>Vector</type>
				</item>
				<item>
					<id>{CA709CE5-95A1-4E3D-80C2-47729AE6C2D8}</id>
					<name>ObjectBinormal</name>
					<type>Vector</type>
				</item>
				<item>
					<id>{14F749EA-DD72-4028-8901-FFCF513C8B49}</id>
					<name>WorldPosition</name>
					<type>Vector</type>
				</item>
				<item>
					<id>{C904A7F6-12C2-4812-9ED4-567601E96309}</id>
					<name>WorldNormal</name>
					<type>Vector</type>
				</item>
				<item>
					<id>{05CF0EDA-E24A-4857-AB52-8BF36295A22D}</id>
					<name>WorldTangent</name>
					<type>Vector</type>
				</item>
				<item>
					<id>{2EB4374D-8D01-494F-9BCD-82AC6F53191F}</id>
					<name>WorldBinormal</name>
					<type>Vector</type>
				</item>
				<item>
					<id>{B91343FA-A7BB-45BC-B4D1-FA8DB61B2C94}</id>
					<name>ViewPosition</name>
					<type>Vector</type>
				</item>
				<item>
					<id>{293D1C14-DAB3-4B16-9C9E-354C9F3E2BA3}</id>
					<name>ViewNormal</name>
					<type>Vector</type>
				</item>
				<item>
					<id>{E302BC4B-83B7-431E-B85B-EB6FAAAB94ED}</id>
					<name>ViewTangent</name>
					<type>Vector</type>
				</item>
				<item>
					<id>{23B652AD-2EF9-44F5-BD06-EA5F59D4702B}</id>
					<name>ViewBinormal</name>
					<type>Vector</type>
				</item>
				<item>
					<id>{F46716DA-802B-4C1F-8715-586604705CC4}</id>
					<name>TexCoord0</name>
					<type>Vector</type>
				</item>
				<item>
					<id>{0F224DAA-9933-4628-B059-6927D3CB0DCE}</id>
					<name>TexCoord1</name>
					<type>Vector</type>
				</item>
				<item>
					<id>{A6A75472-790C-413A-B616-8F8F7FB1F94B}</id>
					<name>Color</name>
					<type>Vector</type>
				</item>
			</outputPins>
			<script><![CDATA[
const uint gid = gl_GlobalInvocationID.x;
const int index = (gid < uint($Count)) ? $Indices[int($Offset) + int(gid)].Index : 0;

const vec4 objectPosition = vec4($Vertices[index].Position.xyz, 1.0f);
const vec4 objectNormal = vec4(vec3($Vertices[index].Normal.xyz), 0.0f);
const vec4 objectTangent = vec4(vec3($Vertices[index].Tangent.xyz), 0.0f);
const vec4 objectBinormal = vec4(vec3($Vertices[index].Binormal.xyz), 0.0f);

const mat4 worldView = $View * $World;

$Index = float(index);

$ObjectPosition = objectPosition;
$ObjectNormal = objectNormal;
$ObjectTangent = objectTangent;
$ObjectBinormal = objectBinormal;

$WorldPosition = $World * objectPosition;
$WorldNormal = $World * objectNormal;
$WorldTangent = $World * objectTangent;
$WorldBinormal = $World * objectBinormal;

$ViewPosition = worldView * objectPosition;
$ViewNormal = worldView * objectNormal;
$ViewTangent = worldView * objectTangent;
$ViewBinormal = worldView * objectBinormal;

$TexCoord0 = vec4($Vertices[index].TexCoord0, 0.0f, 0.0f);
$TexCoord1 = vec4($Vertices[index].TexCoord1, 0.0f, 0.0f);
$Color = vec4($Vertices[index].Color);
			]]></script>
		</item>
