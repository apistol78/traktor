	<nodes>
		<item type="traktor.render.Comment" version="traktor.render.Node:1">
			<id>{6B020A13-E091-4873-9836-6659F9F2EF05}</id>
			<comment><![CDATA[Compute-side vertex source for the Deform technique.
Each invocation handles one entry of the part's vertex index list;
vertex attributes are read from the deform source buffer and
transformed exactly like the raster vertex fragment would, minus
interpolators since everything runs in a single compute stage.]]></comment>
			<position>
				<first>-1500</first>
				<second>100</second>
			</position>
		</item>
