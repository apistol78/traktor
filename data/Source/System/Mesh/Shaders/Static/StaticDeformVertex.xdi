<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.render.ShaderGraph" version="traktor.render.Graph:1">
	<nodes>
		<item type="traktor.render.Comment" version="traktor.render.Node:1">
			<id>{196A26F0-0729-4A1E-BE1C-7168A1029555}</id>
			<comment><![CDATA[Static mesh vertex fragment for deformed (world position offset) materials.
While the instance holds a deform slot (Mesh_DeformSlot >= 0), position and last
position are read from the deform buffers written by the Deform compute technique;
otherwise from the vertex stream. Remaining attributes come from the stream.]]></comment>
			<position>
				<first>-1500</first>
				<second>100</second>
			</position>
		</item>
