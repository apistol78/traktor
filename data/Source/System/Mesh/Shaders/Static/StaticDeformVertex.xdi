		<item type="traktor.render.Script" version="8,traktor.render.Node:1">
			<id>{C097BD5E-FC21-4B60-91E1-6B800CD27A0D}</id>
			<comment/>
			<position>
				<first>-1100</first>
				<second>400</second>
			</position>
			<name>Deform Position</name>
			<technique></technique>
			<domain>Undefined</domain>
			<localSize>
				<X>1</X>
				<Y>1</Y>
				<Z>1</Z>
			</localSize>
			<useRayTracing>false</useRayTracing>
			<include/>
			<inputPins>
				<item>
					<id>{B8E48E5B-479D-416A-90CB-810A4A3BAF2A}</id>
					<name>Slot</name>
				</item>
				<item>
					<id>{268CDA38-2E88-406E-B26E-7EEBE95A1EF6}</id>
					<name>VertexCount</name>
				</item>
				<item>
					<id>{83B6585D-8254-4D0C-AFF2-F6ADE370CAD6}</id>
					<name>DeformBuffer</name>
				</item>
				<item>
					<id>{00CA9E03-E0BF-40D4-AB01-B02A36047A35}</id>
					<name>DeformBufferLast</name>
				</item>
				<item>
					<id>{ADFF85AE-96AB-49B8-A16B-2FDA123D1597}</id>
					<name>StreamPosition</name>
				</item>
			</inputPins>
			<outputPins>
				<item>
					<id>{84950833-99E4-4B0B-B5ED-C0CA5B41591E}</id>
					<name>Position</name>
					<type>Vector</type>
				</item>
				<item>
					<id>{A19B38FB-BC81-49BD-902F-B3D084931BA2}</id>
					<name>LastPosition</name>
					<type>Vector</type>
				</item>
			</outputPins>
			<script><![CDATA[
const int slot = int($Slot);
if (slot >= 0)
{
	const int index = slot * int($VertexCount) + gl_VertexIndex;
	$Position = vec4($DeformBuffer[index].Position.xyz, 1.0f);
	$LastPosition = vec4($DeformBufferLast[index].Position.xyz, 1.0f);
}
else
{
	$Position = vec4($StreamPosition.xyz, 1.0f);
	$LastPosition = $Position;
}
			]]></script>
		</item>
