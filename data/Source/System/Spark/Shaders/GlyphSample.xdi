		<item type="traktor.render.Script" version="8,traktor.render.Node:1">
			<id>{441FB1E2-3D57-8940-A790-0827F2837AED}</id>
			<comment/>
			<position>
				<first>1126</first>
				<second>196</second>
			</position>
			<name>InRange</name>
			<technique/>
			<domain>Undefined</domain>
			<localSize>
				<X>1</X>
				<Y>1</Y>
				<Z>1</Z>
			</localSize>
			<useRayTracing>false</useRayTracing>
			<include/>
			<inputPins>
				<item>
					<id>{DEEC2379-F333-574E-A8CF-FBB816BF250A}</id>
					<name>Input</name>
				</item>
			</inputPins>
			<outputPins>
				<item>
					<id>{2D14AE17-CD0A-CB4F-B253-75E5C10789B4}</id>
					<name>Output</name>
					<type>Scalar</type>
				</item>
			</outputPins>
			<script><![CDATA[
			
const float F = 0.0035;
const float iF = 1.0 - F;
vec2 mn = step($Input.xy, vec2(iF, iF));
vec2 mx = step(vec2(F, F), $Input.xy);
vec2 tm = mn * mx;
$Output = tm.x * tm.y;
			
			]]></script>
		</item>
