		<item type="traktor.render.Script" version="8,traktor.render.Node:1">
			<id>{4D0E2B7A-91C3-4F5E-8A26-3B7C1E9D5F08}</id>
			<comment/>
			<position>
				<first>1474</first>
				<second>-2560</second>
			</position>
			<name>DiskOffset</name>
			<technique/>
			<domain>Undefined</domain>
			<localSize>
				<X>1</X>
				<Y>1</Y>
				<Z>1</Z>
			</localSize>
			<useRayTracing>false</useRayTracing>
			<include/>
			<inputPins>
				<item>
					<id>{9A7C16B2-F249-8C49-919E-A0EE823F1F0F}</id>
					<name>N</name>
				</item>
			</inputPins>
			<outputPins>
				<item>
					<id>{F443347D-8790-3842-91E5-D582CD279220}</id>
					<name>Output</name>
					<type>Vector</type>
				</item>
			</outputPins>
			<script><![CDATA[
// Vogel spiral; 32 taps evenly over a disk of 2 pixels radius.
float r = 2.0 * sqrt(($N + 0.5) / 32.0);
float a = $N * 2.39996;
$Output = vec4(cos(a) * r, sin(a) * r, 0.0, 0.0);
]]></script>
		</item>
