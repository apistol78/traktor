		<item type="traktor.render.Script" version="8,traktor.render.Node:1">
			<id>{B6452895-22EC-E744-B663-47EDCAC36099}</id>
			<comment/>
			<position>
				<first>885</first>
				<second>392</second>
			</position>
			<name>LatticeOffset</name>
			<technique/>
			<domain>Undefined</domain>
			<localSize>
				<X>1</X>
				<Y>1</Y>
				<Z>1</Z>
			</localSize>
			<useRayTracing>false</useRayTracing>
			<include/>
			<inputPins>
				<item>
					<id>{EF6DB6D5-77F8-9D4B-A22F-0DD21523172E}</id>
					<name>N</name>
				</item>
			</inputPins>
			<outputPins>
				<item>
					<id>{890DEA68-29BC-A04F-9E28-788116BB4A5B}</id>
					<name>Output</name>
					<type>Vector</type>
				</item>
			</outputPins>
			<script><![CDATA[
// Rank-1 lattice; 25 distinct rows and columns within one pixel.
$Output = vec4(($N + 0.5) / 25.0 - 0.5, fract(($N * 7.0 + 0.5) / 25.0) - 0.5, 0.0, 0.0);
]]></script>
		</item>
