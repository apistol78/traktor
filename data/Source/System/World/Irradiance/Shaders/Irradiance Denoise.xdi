<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.render.ShaderGraph" version="traktor.render.Graph:1">
	<nodes>
		<item type="traktor.render.Script" version="8,traktor.render.Node:1">
			<id>{40C62AC8-2D77-0C45-87B5-DF9372E21C7A}</id>
			<comment/>
			<position>
				<first>-46</first>
				<second>560</second>
			</position>
			<name>Denoiser</name>
			<technique>Default</technique>
			<domain>Compute</domain>
			<localSize>
				<X>8</X>
				<Y>8</Y>
				<Z>1</Z>
			</localSize>
			<useRayTracing>false</useRayTracing>
			<include>
				<item>{6770B973-C860-9541-A411-28FE83D9EE82}</item>
			</include>
			<inputPins>
				<item>
					<id>{46B2C756-818F-4152-B687-378CB29B78FA}</id>
					<name>Output</name>
				</item>
				<item>
					<id>{7FE9B698-FEC9-BA4B-A49B-A5B8E4C7B302}</id>
					<name>Input</name>
				</item>
				<item>
					<id>{4DFE5822-AF30-C444-82C4-7D5B4669E3CD}</id>
					<name>InputSampler</name>
				</item>
				<item>
					<id>{014CA313-4622-204B-A0D2-3E038FF43BCB}</id>
					<name>Depth</name>
				</item>
				<item>
					<id>{1227A2B1-A931-6249-9150-423F289E5758}</id>
					<name>Random</name>
				</item>
			</inputPins>
			<outputPins/>
			<script><![CDATA[
const int N = 16;
const float NormalRange = 0.5f;
const float DepthRange = 8.0f;

// Firefly rejection; taps are clamped relative to a tone weighted mean of the neighbourhood.
const float LuminanceClampRatio = 4.0f;
const float LuminanceClampFloor = 1.0f;
const vec3 LuminanceCoeff = vec3(0.2126f, 0.7152f, 0.0722f);

const ivec2 outputSize = imageSize($Output);
const ivec2 pt = ivec2(gl_GlobalInvocationID.xy);
if (pt.x >= outputSize.x || pt.y >= outputSize.y)
	return;

const vec2 UV = (vec2(pt) + 0.5f) / vec2(outputSize);
const float offset = BlueNoise(uvec2(pt) + uvec2($Random * 1543, $Random * 543));

const vec2 sz = 1.0f / textureSize($Input, 0);

const vec4 tmp = textureLod(sampler2D($Depth, $InputSampler), UV, 0.0f);
const float centerD = tmp.x;
const vec3 centerN = vec3(tmp.yzw);

const float k = clamp(1.0f - 1.0f / (centerD * 0.1f), 0.0f, 1.0f);
const float radius = mix(20.0f, 6.0f, k);

// 1. Gather taps; index 0 is the centre.
vec3 smp[N + 1];
float wgt[N + 1];

smp[0] = textureLod(sampler2D($Input, $InputSampler), UV, 0.0f).xyz;
wgt[0] = 1.0f;

[[unroll]]
for (int i = 0; i < N; ++i)
{
	const float f = float(i) / N;
	const float a = (f + offset) * 3.14f * 2.0f * 13;
	const vec2 r = f * sz * radius;

	const float dx = cos(a) * r.x;
	const float dy = sin(a) * r.y;

	const vec2 uv = UV + vec2(dx, dy);

	const vec4 tmp = textureLod(sampler2D($Depth, $InputSampler), uv, 0.0f);
	const float sampleD = tmp.x;
	const vec3 sampleN = vec3(tmp.yzw);

	const float dn = clamp((dot(sampleN, centerN) - NormalRange) / (1.0f - NormalRange), 0.0f, 1.0f);
	const float dd = clamp((DepthRange - abs(sampleD - centerD)) / DepthRange, 0.0f, 1.0f);
	const float w = dn * dd;

	[[branch]]
	if (w > 0.01f)
	{
		smp[i + 1] = textureLod(sampler2D($Input, $InputSampler), uv, 0.0f).xyz;
		wgt[i + 1] = w;
	}
	else
	{
		smp[i + 1] = vec3(0.0f);
		wgt[i + 1] = 0.0f;
	}
}

// 2. Tone weighted reference luminance of the neighbourhood.
float refLum = 0.0f;
float refW = 0.0f;

[[unroll]]
for (int i = 0; i <= N; ++i)
{
	const float lum = dot(smp[i], LuminanceCoeff);
	const float tw = wgt[i] / (1.0f + lum);
	refLum += lum * tw;
	refW += tw;
}

refLum /= refW;

const float maxLum = refLum * LuminanceClampRatio + LuminanceClampFloor;

// 3. Blend with each tap clamped to the reference.
vec3 acc = vec3(0.0f);
float W = 0.0f;

[[unroll]]
for (int i = 0; i <= N; ++i)
{
	vec3 s = smp[i];
	const float lum = dot(s, LuminanceCoeff);
	if (lum > maxLum)
		s *= maxLum / lum;
	acc += s * wgt[i];
	W += wgt[i];
}

acc /= W;

imageStore($Output, pt, vec4(acc, 1.0f));

]]></script>
		</item>
