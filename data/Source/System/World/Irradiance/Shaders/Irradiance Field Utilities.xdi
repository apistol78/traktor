<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.render.ShaderModule" version="2">
	<text><![CDATA[
const int GridSize = 128;

const float VolumeExtent = 40.0f;
const float VolumeSize = VolumeExtent * 2.0f;
const float CellExtent = VolumeExtent / GridSize;
const float CellSize = VolumeSize / GridSize;

vec3 IrradianceFieldUV(mat4 viewInverse, vec3 w)
{
	const vec3 origin = viewInverse[3].xyz;
	const vec3 nc = (w.xyz - origin) / vec3(VolumeExtent);
	return nc * 0.5f + 0.5f;
}

vec3 SampleIrradianceField(texture3D irradianceField, mat4 viewInverse, vec3 w)
{
	return texture(sampler3D(irradianceField, irradianceFieldSampler), IrradianceFieldUV(viewInverse, w)).xyz;
}

// Fraction of the sphere open to the sky; zero outside the field.
float SampleSkyVisibility(texture3D irradianceField, mat4 viewInverse, vec3 w)
{
	return texture(sampler3D(irradianceField, irradianceFieldSampler), IrradianceFieldUV(viewInverse, w)).w;
}

vec3 CellToWorldSpace(mat4 viewInverse, ivec3 cell)
{
	const vec3 origin = viewInverse[3].xyz;
	const vec3 cellNC = ((vec3(cell) + 0.5f) / float(GridSize)) * 2.0f - 1.0f;
	return (cellNC * VolumeExtent) + origin;
}]]></text>
	<samplers>
		<item>
			<first>irradianceFieldSampler</first>
			<second>
				<minFilter>Linear</minFilter>
				<mipFilter>Linear</mipFilter>
				<magFilter>Linear</magFilter>
				<addressU>Border</addressU>
				<addressV>Border</addressV>
				<addressW>Border</addressW>
				<compare>None</compare>
				<mipBias>0</mipBias>
				<ignoreMips>true</ignoreMips>
				<useAnisotropic>false</useAnisotropic>
			</second>
		</item>
	</samplers>
	<structDeclarations/>
</object>
