		<item type="traktor.render.Script" version="8,traktor.render.Node:1">
			<id>{5A11D6CE-EC0C-4447-A1B6-B6F076063D79}</id>
			<comment/>
			<position>
				<first>216</first>
				<second>111</second>
			</position>
			<name>Trace</name>
			<technique/>
			<domain>Undefined</domain>
			<localSize>
				<X>1</X>
				<Y>1</Y>
				<Z>1</Z>
			</localSize>
			<useRayTracing>false</useRayTracing>
			<include>
				<item>{921BBC45-4C75-624A-AA78-9B5FEC80645B}</item>
			</include>
			<inputPins>
				<item>
					<id>{604C10BE-ED24-1345-A9A6-A7A49A8D85B9}</id>
					<name>ViewPosition</name>
				</item>
				<item>
					<id>{CBDD0ED8-9E77-A942-821C-661A3DAEE24F}</id>
					<name>LightDirection</name>
				</item>
				<item>
					<id>{096FB3DE-81FD-244E-AF34-C2FC4305E29E}</id>
					<name>Projection</name>
				</item>
				<item>
					<id>{9C6C5E8C-05EC-E24C-8428-59D2B15570DF}</id>
					<name>DepthMap</name>
				</item>
				<item>
					<id>{D9660660-B2EC-504C-9918-F781939970CD}</id>
					<name>DepthMapState</name>
				</item>
			</inputPins>
			<outputPins>
				<item>
					<id>{674137C0-01B2-C440-AA08-128F539983CB}</id>
					<name>Hit</name>
					<type>Scalar</type>
				</item>
			</outputPins>
			<script><![CDATA[
			
const float traceLength = 0.4f;
const int traceSteps = 32;

const float minE = 0.02f;
const float maxE = 0.2f;

$Hit = 0.0f;

vec3 pos = $ViewPosition.xyz;
if (pos.z < 1000.0f)
{
	// Depth change across half a texel, bounds the error of comparing against point sampled depth.
	const vec2 texel = 1.0f / vec2(textureSize(sampler2D($DepthMap, $DepthMapState), 0));
	const vec4 c = $Projection * vec4(pos, 1.0f);
	const vec2 uv = (c.xy / c.w) * vec2(0.5f, -0.5f) + vec2(0.5f, 0.5f);
	const float zl = texture(sampler2D($DepthMap, $DepthMapState), uv - vec2(texel.x, 0.0f)).x;
	const float zr = texture(sampler2D($DepthMap, $DepthMapState), uv + vec2(texel.x, 0.0f)).x;
	const float zu = texture(sampler2D($DepthMap, $DepthMapState), uv - vec2(0.0f, texel.y)).x;
	const float zd = texture(sampler2D($DepthMap, $DepthMapState), uv + vec2(0.0f, texel.y)).x;
	const float slack = 0.5f * (min(abs(pos.z - zl), abs(zr - pos.z)) + min(abs(pos.z - zu), abs(zd - pos.z)));

	vec3 stp = $LightDirection.xyz * traceLength / traceSteps;

	pos += stp * Hash13(pos);

	for (int i = 0; i < traceSteps; ++i)
	{
		pos += stp;
	
		// Read depth at step position.
		vec4 t = $Projection * vec4(pos, 1.0f);
		t.xy /= t.w;
		t.xy *= vec2(0.5f, -0.5f);
		t.xy += vec2(0.5f, 0.5f);
	
		if (t.x < 0.0f || t.x > 1.0f || t.y < 0.0f || t.y > 1.0f)
			break;
	
		const float depth = texture(sampler2D($DepthMap, $DepthMapState), t.xy).x;
		const float e = pos.z - depth - slack;
	
		if (e >= minE && e <= maxE)
		{
			$Hit = 1.0f; // - float(i) / (traceSteps - 1);
			$Hit *= 1.0f - (e - minE) / (maxE - minE);
			break;
		}
	}
}
			
			]]></script>
