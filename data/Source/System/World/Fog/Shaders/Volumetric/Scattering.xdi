			<id>{D7F1C4B0-58E2-4A16-9C7D-3F2B806E519A}</id>
			<comment><![CDATA[Per frame dither of the froxel sample position.]]></comment>
			<position>
				<first>-894</first>
				<second>-897</second>
			</position>
			<parameterDeclaration>{46B1D101-2690-4E45-B38B-963CA9440B66}</parameterDeclaration>
		</item>
		<item type="traktor.render.Script" version="8,traktor.render.Node:1">
			<id>{AC01E3A1-4B63-4D41-92CD-6453BCD401F4}</id>
			<comment/>
			<position>
				<first>1107</first>
				<second>319</second>
			</position>
			<name>TemporalBlend</name>
			<technique/>
			<domain>Undefined</domain>
			<localSize>
				<X>1</X>
				<Y>1</Y>
				<Z>1</Z>
			</localSize>
			<useRayTracing>false</useRayTracing>
			<include/>
			<inputPins>
				<item>
					<id>{8F4BFB54-EF3E-4DBF-A46B-A7B7D101F31C}</id>
					<name>Fresh</name>
				</item>
				<item>
					<id>{B0FAC123-6FEA-4450-B8D0-50C5D2A0CA02}</id>
					<name>History</name>
				</item>
				<item>
					<id>{0519480B-5A3D-49E7-BAF6-642020C28F79}</id>
					<name>HistoryNDC</name>
				</item>
				<item>
					<id>{9C59542D-226C-4B2C-89FB-B198B2364552}</id>
					<name>HistoryViewPosition</name>
				</item>
				<item>
					<id>{7CE2FCAB-2A4D-4AFA-95DD-C8867AC710E1}</id>
					<name>NearZ</name>
				</item>
				<item>
					<id>{223E525F-5CB9-4FEC-A599-B94DC239428F}</id>
					<name>FarZ</name>
				</item>
				<item>
					<id>{023B9249-84A3-4723-A23E-5E880B8B122F}</id>
					<name>VolumeSize</name>
				</item>
			</inputPins>
			<outputPins>
				<item>
					<id>{6E0A4F71-3C5D-4A88-9B12-70E1D5C4A833}</id>
					<name>Output</name>
					<type>Vector</type>
				</item>
			</outputPins>
			<script><![CDATA[// Blend the reprojected history in, but only where the reprojection actually
// landed inside the previous frame's volume.
//
// The history sampler clamps, so a lookup that fell outside returns an edge
// froxel. Accepting that unconditionally - which is what happened while this
// check sat disconnected from the graph - drags edge froxels inwards every time
// the camera turns. The volume is also pool allocated and never cleared, so on
// the first frame the history is whatever was in memory, and a non finite value
// there would survive at 90% weight forever.
//
// Validity is tested on the reprojected position, not on the NDC alone, because
// ViewspaceToNDC clamps the depth fraction and so cannot report a position that
// fell out of the volume in z.

const vec4 fresh = $Fresh;
const vec4 history = $History;

const vec2 ndcXY = $HistoryNDC.xy;
const float k = ($HistoryViewPosition.z - $NearZ) / max($FarZ - $NearZ, 0.0001f);

// One froxel of margin in x and y, so trilinear filtering never reaches past
// the edge of the previous volume.
const vec2 margin = 1.0f / max(vec2($VolumeSize.xy), vec2(1.0f));

bool inside =
	all(greaterThanEqual(ndcXY, -1.0f + margin)) &&
	all(lessThanEqual(ndcXY, 1.0f - margin)) &&
	k >= 0.0f && k <= 1.0f;

bool finite = all(lessThan(abs(history), vec4(65504.0f)));

if (!inside || !finite)
	$Output = fresh;
else
{
	// Where the history disagrees strongly with what this froxel now scatters it
	// is stale rather than merely noisy, so shorten its tail. A flat 90% history
	// needs around 22 frames to catch up with a light switching on.
	const float f = dot(fresh.rgb, vec3(1.0f));
	const float h = dot(history.rgb, vec3(1.0f));
	const float disagreement = clamp(abs(h - f) / max(max(h, f), 0.0001f), 0.0f, 1.0f);

	$Output = mix(fresh, history, mix(0.9f, 0.5f, disagreement));
}
]]></script>
		</item>
		<item type="traktor.render.Parameter" version="traktor.render.Node:1">
			<id>{5F3D8A17-4C29-4B60-9E81-A2704D6BC395}</id>
			<comment/>
			<position>
				<first>-1002</first>
				<second>200</second>
			</position>
			<parameterDeclaration>{EA77CECB-1DC2-E340-B4CE-3E94B17C8061}</parameterDeclaration>
		</item>
		<item type="traktor.render.Script" version="8,traktor.render.Node:1">
			<id>{B8E73A29-177B-4407-9884-6CC25245AA77}</id>
			<comment/>
			<position>
				<first>-698</first>
				<second>248</second>
			</position>
			<name>IrradianceAmbient</name>
			<technique/>
			<domain>Undefined</domain>
			<localSize>
				<X>1</X>
				<Y>1</Y>
				<Z>1</Z>
			</localSize>
			<useRayTracing>false</useRayTracing>
			<include/>
			<inputPins>
				<item>
					<id>{6CB2FF98-BAD2-43F8-8478-38E770E0563D}</id>
					<name>Grid</name>
				</item>
				<item>
					<id>{69989B50-2621-46B9-8B61-9D184E7CF59C}</id>
					<name>WorldPosition</name>
				</item>
				<item>
					<id>{01EBE9A6-CFA9-4D00-862F-4A707C203794}</id>
					<name>GridBoundsMin</name>
				</item>
				<item>
					<id>{68A5E9F6-A0D5-468E-B9E5-9DD4CC806F3E}</id>
					<name>GridBoundsMax</name>
				</item>
				<item>
					<id>{4705B506-9404-4ECD-B3A8-DAD522CB6552}</id>
					<name>GridSize</name>
				</item>
			</inputPins>
			<outputPins>
				<item>
					<id>{4A7CC092-4332-4B28-8E2B-CD6D1F68F25B}</id>
					<name>Output</name>
					<type>Vector</type>
				</item>
			</outputPins>
			<script><![CDATA[// Ambient in-scattering from the irradiance grid.
//
// Without this a froxel no analytic light reaches scatters nothing, so fog goes
// black in shadow. The grid is the same data the surface lighting samples, so
// fog ambient and surfaces agree by construction, and because it is spatial the
// fog correctly dims under a canopy or indoors.
//
// Only the band 0 coefficient is taken. For a normalised SH basis that term IS
// the average radiance over the sphere, which is exactly the isotropic ambient
// wanted here - evaluating the full SH against some chosen normal would instead
// give the cosine weighted irradiance from that one direction. It is also far
// cheaper: three scalar loads per cell rather than the whole 28 float record,
// and no SH evaluation at all.
//
// The phase function is normalised, so a field of uniform radiance L in-scatters
// exactly L; this therefore adds straight into the analytic light sum.

const vec3 wp = $WorldPosition.xyz;
const vec3 mn = $GridBoundsMin.xyz;
const vec3 mx = $GridBoundsMax.xyz;

// The grid size is uploaded biased by half a unit, so truncate to recover it.
const vec3 gs = trunc($GridSize.xyz);

const vec3 t = clamp((wp - mn) / max(mx - mn, vec3(0.0001f)), vec3(0.0f), vec3(1.0f));
const vec3 p = t * gs;
const vec3 gp = trunc(p);
const vec3 f = fract(p);

// Cell index is x * (gy * gz) + y * gz + z; the stride is the index delta to
// the next cell along each axis, clamped so the far edge does not wrap.
const vec3 factors = vec3(gs.y * gs.z, gs.z, 1.0f);
const float base = dot(gp, factors);
const vec3 stride = (min(gp + vec3(1.0f), gs - vec3(1.0f)) - gp) * factors;

// Trilinear over the eight surrounding cells, same footprint the surface
// lighting uses, so the ambient does not read as blocky.
vec3 dc = vec3(0.0f);
for (int i = 0; i < 8; ++i)
{
	const vec3 o = vec3(float(i & 1), float((i >> 1) & 1), float((i >> 2) & 1));
	const vec3 wv = mix(vec3(1.0f) - f, f, o);
	const int j = int(base + dot(o, stride));
	dc += (wv.x * wv.y * wv.z) * vec3($Grid[j].shR0_3.x, $Grid[j].shG0_3.x, $Grid[j].shB0_3.x);
}

// Band 0 of the normalised basis is 1 / (2 sqrt(pi)).
$Output = vec4(dc * 0.2820947917738781f, 1.0f);
]]></script>
		</item>
