		<item type="traktor.render.Script" version="8,traktor.render.Node:1">
			<id>{911C2F45-5FC5-EA4B-8C28-64658E670ADE}</id>
			<comment/>
			<position>
				<first>-662</first>
				<second>-919</second>
			</position>
			<name>FrustumCellToViewspace</name>
			<technique/>
			<domain>Undefined</domain>
			<localSize>
				<X>1</X>
				<Y>1</Y>
				<Z>1</Z>
			</localSize>
			<useRayTracing>false</useRayTracing>
			<include>
				<item>{328E6693-7B5B-5B4F-AC6B-987ECADAE330}</item>
			</include>
			<inputPins>
				<item>
					<id>{6555AF5E-69B9-2147-A90C-1E6220A22100}</id>
					<name>VolumeSize</name>
				</item>
				<item>
					<id>{79BAF5AF-B891-3D4E-B2E7-CD0F7C03AEC1}</id>
					<name>MagicCoeffs</name>
				</item>
				<item>
					<id>{FEC7D688-4B39-AC46-AF38-B4D6412CFFB3}</id>
					<name>NearZ</name>
				</item>
				<item>
					<id>{ADA5C76A-DB22-EA40-8133-B2A9979C5A07}</id>
					<name>FarZ</name>
				</item>
				<item>
					<id>{D5630BB7-FC83-7640-9DB2-CFB485EFD5A6}</id>
					<name>Cell</name>
				</item>
				<item>
					<id>{51CEE10C-679B-4168-997D-D496FBCF2A56}</id>
					<name>Jitter</name>
				</item>
			</inputPins>
			<outputPins>
				<item>
					<id>{72D7AC3C-9B4B-5142-93FB-40DC055DDADE}</id>
					<name>Output</name>
					<type>Vector</type>
				</item>
			</outputPins>
			<script><![CDATA[
VSFrustum vsf;
vsf.volumeSize = ivec3($VolumeSize.xyz);
vsf.magicCoeffs = $MagicCoeffs.xy;
vsf.nearZ = $NearZ;
vsf.farZ = $FarZ;

// Sample the froxel at its centre in x and y rather than at its minimum
// corner, and dither the depth within the froxel from frame to frame. The
// temporal blend then averages those samples towards the slice's true mean,
// which is what removes the banding a fixed corner sample leaves along z.
// A jitter of [0,1) added to the cell index has its expectation at the centre.
const vec3 cell = $Cell.xyz + vec3(0.5f, 0.5f, fract($Jitter));

const vec3 ndc = FrustumCellToNDC(vsf, cell);
const vec3 vs = NDCToViewspace(vsf, ndc);
$Output = vec4(vs, 1.0f);

]]></script>
		</item>
