		<item type="traktor.render.Script" version="8,traktor.render.Node:1">
			<id>{AF10E59E-248D-434D-901A-F22C29885AC2}</id>
			<comment/>
			<position>
				<first>886</first>
				<second>-10</second>
			</position>
			<name>Mie Scattering Phase</name>
			<technique/>
			<domain>Undefined</domain>
			<localSize>
				<X>1</X>
				<Y>1</Y>
				<Z>1</Z>
			</localSize>
			<useRayTracing>false</useRayTracing>
			<include/>
			<inputPins>
				<item>
					<id>{0D22C808-9FE4-B548-89F0-8D6BF18DBFCF}</id>
					<name>Input</name>
				</item>
				<item>
					<id>{3C8A5D14-7E06-42B9-B5FC-90D2718AE643}</id>
					<name>Phase</name>
				</item>
			</inputPins>
			<outputPins>
				<item>
					<id>{444C9199-3D65-514B-B3F3-EF9295325ED3}</id>
					<name>Output</name>
					<type>Scalar</type>
				</item>
			</outputPins>
			<script><![CDATA[// Two lobe Henyey-Greenstein phase function.
//
// g - the asymmetry parameter - is the mean cosine of the scattering angle: 0 is
// isotropic, positive forward, negative backward. Its forward to backward ratio
// is ((1 + g) / (1 - g))^3, so g alone decides how much brighter fog reads
// looking into a light than away from it, which is what governs god rays.
//
// A single lobe cannot be both sharply forward and carry any backscatter, which
// real droplets do, so two are mixed - the same shape the sky module's cloud
// rendering uses. Both lobes are individually normalised and the mix is convex,
// so the result still integrates to one over the sphere. Both the slice
// integration and the ambient term depend on that normalisation.

const float PI = 3.14159265f;

// Clamped short of one; at |g| = 1 the forward denominator (1 - g)^2 is zero.
const float gF = clamp($Phase.x, -0.95f, 0.95f);
const float gB = clamp($Phase.y, -0.95f, 0.95f);
const float blend = clamp($Phase.z, 0.0f, 1.0f);

const float cosTheta = $Input;

const float ggF = gF * gF;
const float ggB = gB * gB;

const float pF = (1.0f - ggF) / (4.0f * PI * pow(max(1.0f + ggF - 2.0f * gF * cosTheta, 0.0001f), 1.5f));
const float pB = (1.0f - ggB) / (4.0f * PI * pow(max(1.0f + ggB - 2.0f * gB * cosTheta, 0.0001f), 1.5f));

$Output = mix(pF, pB, blend);
]]></script>
		</item>
