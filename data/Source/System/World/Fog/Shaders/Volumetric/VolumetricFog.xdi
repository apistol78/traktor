		<item type="traktor.render.TextureState" version="1,traktor.render.Node:1">
			<id>{72CB2BB2-AD47-468B-B7E2-15182D290E40}</id>
			<comment><![CDATA[Trilinear, so a pixel between froxels interpolates the accumulation.]]></comment>
			<position>
