		<item type="traktor.render.Script" version="8,traktor.render.Node:1">
			<id>{CADA2E4A-41B7-4304-9D18-53331977D97D}</id>
			<comment/>
			<position>
				<first>-450</first>
				<second>120</second>
			</position>
			<name>ApplyFogVolume</name>
			<technique/>
			<domain>Undefined</domain>
			<localSize>
				<X>1</X>
				<Y>1</Y>
				<Z>1</Z>
			</localSize>
			<useRayTracing>false</useRayTracing>
			<include>
				<item>{328E6693-7B5B-5B4F-AC6B-987ECADAE330}</item>
			</include>
			<inputPins>
				<item>
					<id>{C9AB55AD-1383-4ACA-AD33-566292397756}</id>
					<name>Color</name>
				</item>
				<item>
					<id>{2A5A22B8-D7A9-4820-8E18-113215A482FE}</id>
					<name>ViewPosition</name>
				</item>
				<item>
					<id>{83A358B2-9508-4377-90FE-2D762D1BB2E3}</id>
					<name>Volume</name>
				</item>
				<item>
					<id>{FFBCEBBB-8673-4B0E-AFED-36F78B770A17}</id>
					<name>VolumeState</name>
				</item>
				<item>
					<id>{A1C653B9-F48D-49B0-AC3C-E21EAB71219B}</id>
					<name>FogVolumeRange</name>
				</item>
				<item>
					<id>{1FCD7890-1476-421D-AAB8-9DC7AD4C947D}</id>
					<name>MagicCoeffs</name>
				</item>
			</inputPins>
			<outputPins>
				<item>
					<id>{B1F47FF2-9D2F-453D-91D0-9F8C873611DD}</id>
					<name>Output</name>
					<type>Vector</type>
				</item>
			</outputPins>
			<script><![CDATA[// Apply the integrated fog volume.
//
// The integration pass has already walked each froxel column front to back, so
// a froxel holds the in-scattering accumulated from the camera to its depth
// together with the transmittance to that same depth. All that is left here is
// to locate this pixel's froxel and composite - one trilinear tap, where this
// used to loop up to a full slice count of 3D texture fetches per pixel in
// every shader that includes Fog.

const vec3 vp = $ViewPosition.xyz;

const ivec3 volumeSize = textureSize(sampler3D($Volume, $VolumeState), 0);
const float sliceCount = max(float(volumeSize.z), 1.0f);

VSFrustum vsf;
vsf.volumeSize = volumeSize;
vsf.magicCoeffs = $MagicCoeffs.xy;
vsf.nearZ = $FogVolumeRange.x;
vsf.farZ = $FogVolumeRange.y;

// The slice distribution lives in the module, so ask it rather than repeating
// the exponent here - a module's #define is consumed by the preprocessor while
// resolving that module and is not visible from a script that includes it, so
// only its functions can be relied on. ViewspaceToNDC clamps the depth
// fraction, which keeps a surface outside the volume from producing a NaN.
const vec3 ndc = ViewspaceToNDC(vsf, vec3(vp.xy, max(vp.z, 0.0001f)));

const vec2 uv = ndc.xy * vec2(0.5f, -0.5f) + vec2(0.5f, 0.5f);

// Slice n holds the integral through its FAR boundary, at fraction
// (n + 1) / sliceCount, while its texel centre sits at (n + 0.5) / sliceCount -
// hence stepping back half a texel. A surface past the volume clamps to the
// last slice, which is the fully integrated value, and that is exactly where
// the distance fog picks up.
const float w = clamp(ndc.z - 0.5f / sliceCount, 0.0f, 1.0f);

const vec4 fog = texture(sampler3D($Volume, $VolumeState), vec3(uv, w));

const vec3 inScattering = fog.rgb;
const float transmittance = clamp(fog.a, 0.0f, 1.0f);

$Output = vec4($Color.rgb * transmittance + inScattering, $Color.a);
]]></script>
		</item>
