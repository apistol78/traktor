		<item type="traktor.render.Script" version="8,traktor.render.Node:1">
			<id>{E0A9EAF2-632F-40D1-94E5-08FC04377201}</id>
			<comment/>
			<position>
				<first>1169</first>
				<second>-103</second>
			</position>
			<name>FogFactor</name>
			<technique/>
			<domain>Undefined</domain>
			<localSize>
				<X>1</X>
				<Y>1</Y>
				<Z>1</Z>
			</localSize>
			<useRayTracing>false</useRayTracing>
			<include/>
			<inputPins>
				<item>
					<id>{7EA62CDE-55A9-4838-AEB7-1A0C02143160}</id>
					<name>Distance</name>
				</item>
				<item>
					<id>{66EA8578-6EE5-45DA-83D6-AC81CB57A124}</id>
					<name>Density</name>
				</item>
			</inputPins>
			<outputPins>
				<item>
					<id>{6B6BADC6-F11B-42DA-B348-CFA90E59CCF7}</id>
					<name>Output</name>
					<type>Scalar</type>
				</item>
			</outputPins>
			<script><![CDATA[			
$Output = 1.0f - 1.0f / exp($Distance * $Density);
			]]></script>
		</item>
		<item type="traktor.render.Parameter" version="traktor.render.Node:1">
