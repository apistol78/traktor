		<item type="traktor.render.Script" version="8,traktor.render.Node:1">
			<id>{128DC1D0-7EB0-234A-9D4D-FBC6AFADE4E2}</id>
			<comment/>
			<position>
				<first>1366</first>
				<second>908</second>
			</position>
			<name>Filmic</name>
			<technique/>
			<domain>Undefined</domain>
			<localSize>
				<X>1</X>
				<Y>1</Y>
				<Z>1</Z>
			</localSize>
			<useRayTracing>false</useRayTracing>
			<include/>
			<inputPins>
				<item>
					<id>{BF25B3F5-27C1-4BAF-96E6-6F89709FE145}</id>
					<name>Input</name>
				</item>
			</inputPins>
			<outputPins>
				<item>
					<id>{965F4B3F-E6BC-4E27-92D5-B5A0AF893749}</id>
					<name>Output</name>
					<type>Vector</type>
				</item>
			</outputPins>
			<script><![CDATA[
			
vec3 x = max($Input.xyz, vec3(0.0f));
float a = 3.0f;
float b = 0.1f;
float c = 1.25f;
float d = 1.4f;
float e = 0.6f;
$Output = vec4(
	clamp((x * (a * x + b)) / (x * (c * x + d) + e), vec3(0.0f, 0.0f, 0.0f), vec3(1.0f, 1.0f, 1.0f)),
	1.0f
);

			
			]]></script>
		</item>
