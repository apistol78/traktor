		<item type="traktor.render.Script" version="8,traktor.render.Node:1">
			<id>{91F994E3-6DA8-4872-9F9B-A4B47B8604D7}</id>
			<comment/>
			<position>
				<first>450</first>
				<second>380</second>
			</position>
			<name>AgX Punchy HDR</name>
			<technique/>
			<domain>Undefined</domain>
			<localSize>
				<X>1</X>
				<Y>1</Y>
				<Z>1</Z>
			</localSize>
			<useRayTracing>false</useRayTracing>
			<include>
				<item>{D6F2CE29-93E2-497B-AFDA-AFC95DD6F7BA}</item>
				<item>{3EF0BFCA-5F1E-CF48-BDD8-2FDE306A9696}</item>
			</include>
			<inputPins>
				<item>
					<id>{42153BC6-DC94-4B1B-890F-9E65C9424A71}</id>
					<name>Input</name>
				</item>
			</inputPins>
			<outputPins>
				<item>
					<id>{C466E3DB-DCC5-4D75-B230-FFEB90D4EAD2}</id>
					<name>Output</name>
					<type>Vector</type>
				</item>
			</outputPins>
			<script><![CDATA[// AgX with the "punchy" look; lifted contrast and saturation.
// HDR variant; highlights above the AgX white point extend into the display
// headroom rather than clipping at display white.
const vec3 logT = AgXLog($Input.xyz);
vec3 agx = AgXSigmoid(logT);
agx = AgXLook(agx, vec3(1.0f), vec3(0.0f), vec3(1.35f), 1.4f);
$Output = vec4(AgXDecodeHDR(agx, logT, c_hdrHeadroom), 1.0f);
]]></script>
		</item>
		<item type="traktor.render.OutputPort" version="traktor.render.Node:1">
			<id>{AFD30244-42C2-46BE-96C9-021404B30AD1}</id>
			<comment/>
			<position>
				<first>750</first>
				<second>400</second>
			</position>
			<name>Output</name>
		</item>
	</nodes>
