					<type>Vector</type>
				</item>
			</outputPins>
			<script><![CDATA[// AgX with the "golden" look; warm cast, softened contrast, desaturated.
vec3 agx = AgXEncode($Input.xyz);
agx = AgXLook(agx, vec3(1.0f, 0.9f, 0.5f), vec3(0.0f), vec3(0.8f), 0.8f);
$Output = vec4(AgXDecode(agx), 1.0f);
]]></script>
		</item>
