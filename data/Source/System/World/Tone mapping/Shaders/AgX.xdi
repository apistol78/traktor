<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.render.ShaderModule" version="2">
	<text><![CDATA[
// AgX tone mapping, after Troy Sobotka's AgX.
//
// The chain is split so a "look" can be graded in between; looks operate on
// the sigmoid output, before the outset matrix takes it back to display.

const mat3 c_agxInset = mat3(
	0.842479062253094f, 0.0423282422610123f, 0.0423756549057051f,
	0.0784335999999992f, 0.878468636469772f, 0.0784336f,
	0.0792237451477643f, 0.0791661274605434f, 0.879142973793104f
);
const mat3 c_agxOutset = mat3(
	1.19687900512017f, -0.0528968517574562f, -0.0529716355144438f,
	-0.0980208811401368f, 1.15190312990417f, -0.0980434501171241f,
	-0.0990297440797205f, -0.0989611768448433f, 1.15107367264116f
);
const float c_agxMinEv = -12.47393f;
const float c_agxMaxEv = 4.026069f;

// Scene referred, exposed color into normalized AgX log space, where 0 is
// c_agxMinEv and 1 is c_agxMaxEv. Deliberately not clamped at the top; HDR
// output needs to know how far above the white point the scene went.
vec3 AgXLog(vec3 color)
{
	vec3 v = c_agxInset * max(color, vec3(0.0f));
	v = log2(max(v, vec3(1e-10f)));
	return (v - c_agxMinEv) / (c_agxMaxEv - c_agxMinEv);
}

// Normalized AgX log space, sigmoid compressed into display range.
vec3 AgXSigmoid(vec3 logT)
{
	const vec3 v = clamp(logT, vec3(0.0f), vec3(1.0f));

	// Sigmoid, 6th order polynomial approximation.
	const vec3 v2 = v * v;
	const vec3 v4 = v2 * v2;
	return 15.5f * v4 * v2
		- 40.14f * v4 * v
		+ 31.96f * v4
		- 6.868f * v2 * v
		+ 0.4298f * v2
		+ 0.1191f * v
		- 0.00232f;
}

// Scene referred, exposed color into AgX log space, sigmoid compressed.
vec3 AgXEncode(vec3 color)
{
	return AgXSigmoid(AgXLog(color));
}

// ASC CDL style grade of an AgX encoded color; this is what defines a look.
vec3 AgXLook(vec3 color, vec3 slope, vec3 offset, vec3 power, float saturation)
{
	const float luma = dot(color, vec3(0.2126f, 0.7152f, 0.0722f));
	const vec3 graded = pow(max(color * slope + offset, vec3(0.0f)), power);
	return luma + saturation * (graded - luma);
}

// AgX encoded color into display linear; gamma is applied in a later pass.
vec3 AgXDecode(vec3 color)
{
	const vec3 v = pow(max(c_agxOutset * color, vec3(0.0f)), vec3(2.2f));
	return clamp(v, vec3(0.0f), vec3(1.0f));
}

// As AgXDecode, but the scene detail that fell above the AgX white point is
// spread into HDR headroom instead of clipped against display white.
//
// "logT" is the unclamped AgXLog value the encode started from and "headroom"
// is display peak in multiples of paper white. Channels at or below the white
// point come out identical to AgXDecode, so the SDR rendering of shadows and
// midtones is preserved exactly and only the highlights change.
vec3 AgXDecodeHDR(vec3 color, vec3 logT, float headroom)
{
	const vec3 v = pow(max(c_agxOutset * color, vec3(0.0f)), vec3(2.2f));
	if (headroom <= 1.0f)
		return clamp(v, vec3(0.0f), vec3(1.0f));

	// Stops of scene detail above the white point, which AgXEncode clipped.
	const vec3 over = max(logT - 1.0f, vec3(0.0f)) * (c_agxMaxEv - c_agxMinEv);

	// Spread them across the headroom, approaching peak asymptotically. Zero at
	// the white point so the handover from the sigmoid stays continuous, and it
	// cannot overshoot peak no matter how bright the scene got.
	const float stops = log2(headroom);
	const vec3 lift = (headroom - 1.0f) * (1.0f - exp2(-over / stops));

	return clamp(v + lift, vec3(0.0f), vec3(headroom));
}
]]></text>
	<samplers/>
	<structDeclarations/>
</object>
