		<item type="traktor.render.Script" version="8,traktor.render.Node:1">
			<id>{95E1E131-C36E-6241-921E-BEE81E849E0E}</id>
			<comment/>
			<position>
				<first>1353</first>
				<second>1110</second>
			</position>
			<name>Filmic</name>
			<technique/>
			<domain>Undefined</domain>
			<localSize>
				<X>1</X>
				<Y>1</Y>
				<Z>1</Z>
			</localSize>
			<useRayTracing>false</useRayTracing>
			<include/>
			<inputPins>
				<item>
					<id>{1EB4FB16-C75B-49E8-90F8-FD0EA9FD6BE4}</id>
					<name>Input</name>
				</item>
			</inputPins>
			<outputPins>
				<item>
					<id>{478CA792-AC2C-47A7-BFEA-08CC109AA24F}</id>
					<name>Output</name>
					<type>Vector</type>
				</item>
			</outputPins>
			<script><![CDATA[
			
vec3 x = max($Input.xyz, vec3(0.0f, 0.0f, 0.0f));
float a = 3.75f;
float b = 0.05f;
float c = 1.25f;
float d = 1.3f;
float e = 0.5f;
$Output = vec4(
	clamp((x * (a * x + b)) / (x * (c * x + d) + e), vec3(0.0f, 0.0f, 0.0f), vec3(1.0f, 1.0f, 1.0f)),
	1.0f
);

			
			]]></script>
		</item>
