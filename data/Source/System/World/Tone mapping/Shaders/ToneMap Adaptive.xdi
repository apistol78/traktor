		<item type="traktor.render.Script" version="8,traktor.render.Node:1">
			<id>{76366C69-69F9-D941-8A1F-F4CE61CF15B8}</id>
			<comment/>
			<position>
				<first>1402</first>
				<second>936</second>
			</position>
			<name>Filmic</name>
			<technique/>
			<domain>Undefined</domain>
			<localSize>
				<X>1</X>
				<Y>1</Y>
				<Z>1</Z>
			</localSize>
			<useRayTracing>false</useRayTracing>
			<include/>
			<inputPins>
				<item>
					<id>{0F9D7372-9621-40DC-903D-BFF42C98763F}</id>
					<name>Input</name>
				</item>
			</inputPins>
			<outputPins>
				<item>
					<id>{0CE485C1-063D-4D13-95BF-1DA6E3E60E05}</id>
					<name>Output</name>
					<type>Vector</type>
				</item>
			</outputPins>
			<script><![CDATA[
			
vec3 x = max($Input.xyz, vec3(0.0f));
float a = 3.0f;
float b = 0.1f;
float c = 1.25f;
float d = 1.4f;
float e = 0.6f;
$Output = vec4(
	clamp((x * (a * x + b)) / (x * (c * x + d) + e), vec3(0.0f, 0.0f, 0.0f), vec3(1.0f, 1.0f, 1.0f)),
	1.0f
);

			
			]]></script>
		</item>
