		<item type="traktor.render.Script" version="8,traktor.render.Node:1">
			<id>{3F7E1BD6-8ECA-F44D-AFD6-4F9E5236FF25}</id>
			<comment/>
			<position>
				<first>1353</first>
				<second>1110</second>
			</position>
			<name>Filmic</name>
			<technique/>
			<domain>Undefined</domain>
			<localSize>
				<X>1</X>
				<Y>1</Y>
				<Z>1</Z>
			</localSize>
			<useRayTracing>false</useRayTracing>
			<include/>
			<inputPins>
				<item>
					<id>{C7A7C9B6-0574-42A0-838D-1FA2B6F02DCA}</id>
					<name>Input</name>
				</item>
			</inputPins>
			<outputPins>
				<item>
					<id>{84199B99-7AAD-4FDA-80BB-5D0662CF02EB}</id>
					<name>Output</name>
					<type>Vector</type>
				</item>
			</outputPins>
			<script><![CDATA[
			
vec3 x = max($Input.xyz, vec3(0.0f, 0.0f, 0.0f));
float a = 3.75f;
float b = 0.05f;
float c = 1.25f;
float d = 1.3f;
float e = 0.5f;
$Output = vec4(
	clamp((x * (a * x + b)) / (x * (c * x + d) + e), vec3(0.0f, 0.0f, 0.0f), vec3(1.0f, 1.0f, 1.0f)),
	1.0f
);

			
			]]></script>
		</item>
