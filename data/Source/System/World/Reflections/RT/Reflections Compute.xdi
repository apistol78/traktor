					<type>Vector</type>
				</item>
			</outputPins>
			<script><![CDATA[const ivec2 sz = imageSize($Target);
const ivec2 pt = ivec2(gl_GlobalInvocationID.xy);
$TexCoord = vec4(
	vec2(pt + 0.5f) / sz,
	vec2(pt) / sz
);

]]></script>
