				<Z>1</Z>
			</localSize>
			<useRayTracing>false</useRayTracing>
			<include>
				<item>{6770B973-C860-9541-A411-28FE83D9EE82}</item>
			</include>
			<inputPins>
				<item>
					<id>{1DF0F178-B64F-6241-ABE3-D2A9CDA22F59}</id>
					<name>Time</name>
				</item>
			</inputPins>
			<outputPins>
				<item>
					<id>{44B0EB5B-FD76-664F-BEF6-CC1A605D67A7}</id>
					<name>Output</name>
					<type>Scalar</type>
				</item>
			</outputPins>
			<script><![CDATA[uvec2 seed = uvec2(gl_GlobalInvocationID.xy);
seed += uvec2($Time * 1543, $Time * 543);
$Output = BlueNoise(seed);
			]]></script>
