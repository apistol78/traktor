			</localSize>
			<useRayTracing>true</useRayTracing>
			<include>
				<item>{1C13688E-63BC-3141-ACB1-58EEE72EEF2F}</item>
				<item>{0E3643A0-A0DA-B649-9FD8-930F4EB6D42A}</item>
				<item>{4370C471-3C5D-914B-A3AC-866BE15AD328}</item>
				<item>{921BBC45-4C75-624A-AA78-9B5FEC80645B}</item>
				<item>{6ED30419-6A30-3D41-9583-D6E71FFE0064}</item>
				<item>{D2199F29-20FD-BB44-9484-F57840FF0332}</item>
				<item>{B0DD317D-C0CA-C643-BB47-F779870ECA5F}</item>
			</include>
			<inputPins>
				<item>
					<id>{36FAF013-142C-734F-AC73-58C0158F6F10}</id>
					<name>AS</name>
				</item>
				<item>
					<id>{441A1E89-2118-AD43-87D7-6CF2377B7269}</id>
					<name>Origin</name>
				</item>
				<item>
					<id>{DC54520E-3359-194B-8F2F-E96244166F03}</id>
					<name>Direction</name>
				</item>
				<item>
					<id>{20DB4CFB-5A76-C047-AD4A-F2B47228C9E1}</id>
					<name>Random</name>
				</item>
				<item>
					<id>{AB936A93-53D5-E645-8DFF-D4273CCA86A1}</id>
					<name>Lights</name>
				</item>
				<item>
					<id>{80D14EC1-E0D4-9945-8754-C057B87C48EA}</id>
					<name>LightCount</name>
				</item>
				<item>
					<id>{BA3F042A-9BF5-1C4F-9C3F-851F24E237C1}</id>
					<name>ViewInverse</name>
				</item>
				<item>
					<id>{D5B16104-DD37-E946-973B-A0C8A5AA8D24}</id>
					<name>Reservoir</name>
				</item>
				<item>
					<id>{CBA21546-2DF0-3949-94AB-F417B6E7648C}</id>
					<name>ReservoirOutput</name>
				</item>
				<item>
					<id>{53E0A0BE-AE4C-5C49-AECF-B208BCDEFFE1}</id>
					<name>Output</name>
				</item>
				<item>
					<id>{33689F09-3AEE-DF4F-99B6-C1AEA9D41062}</id>
					<name>Velocity</name>
				</item>
				<item>
					<id>{BDF18CC9-6DF2-A04B-9B72-98D8BC544ADA}</id>
					<name>Depth</name>
				</item>
				<item>
					<id>{24BB1E3B-ADF0-E14A-A67D-19A649EA1F16}</id>
					<name>Roughness</name>
				</item>
				<item>
					<id>{68B73378-5073-CE4D-8FEE-4A963E3F5650}</id>
					<name>Sky</name>
				</item>
				<item>
					<id>{2244E4F8-B5FF-0F4E-A409-0207D71D8605}</id>
					<name>ViewPosition</name>
				</item>
				<item>
					<id>{B8DB5064-33AB-374F-A507-D41E2A167E68}</id>
					<name>ViewNormal</name>
				</item>
				<item>
					<id>{36D10284-E317-C34A-A043-FF1A268214D1}</id>
					<name>Projection</name>
				</item>
				<item>
					<id>{38869D9A-B68E-7841-8328-B5B95F51015A}</id>
					<name>DepthMap</name>
				</item>
				<item>
					<id>{8A3293EE-5057-AC47-8B1E-A134AF4F4EE4}</id>
					<name>DepthMapState</name>
				</item>
				<item>
					<id>{9B8EC21B-2C5D-614B-8E43-AAAA777A532A}</id>
					<name>SceneColor</name>
				</item>
				<item>
					<id>{981F4838-CA5E-9B4A-9EDC-4E1256729ED3}</id>
					<name>SceneColorState</name>
				</item>
			</inputPins>
			<outputPins/>
			<script><![CDATA[
#define USE_TEMPORAL_FILTER 0
#define USE_SPATIAL_FILTER 0

const int N = 1;
const int Ndisclose = 4;
const int K = 8;
const float NormalThreshold = 0.95f;
const float DepthThreshold = 10.0f;
const float Far = 20.0f;
const float SpatialFilterRadius = 0.005f;
const float SpatialFilterCoeff = 0.75f;

const ivec2 sz = imageSize($Output);
const ivec2 pt = ivec2(gl_GlobalInvocationID.xy);
const int index = pt.x + pt.y * sz.x;
const vec2 hdv = sign($Velocity.xy) * 0.5f;
const ivec2 uvpt = pt - ivec2($Velocity.xy * vec2(sz) + hdv);
const ivec2 cvpt = clamp(uvpt, ivec2(0), sz - 1);
const int lastIndex = cvpt.x + cvpt.y * sz.x;
const bool lastIndexOutside = (uvpt != cvpt);

int rndState = int($Random * 54312.0f);

if (pt.x < sz.x && pt.y < sz.y)
{
	$typeof(Reservoir) reservoir;
	Reservoir_Empty(reservoir);

	bool temporalValid = !lastIndexOutside;

	// 3. Sample generation.
	if ($Roughness < 0.4f)
	{
		// Screen space reflection first, fallback to RT if no hit.
		vec2 ssUV;
		float ssAtt;

		[[branch]]
		if (SSR_Trace($ViewPosition.xyz, $ViewNormal.xyz, $Projection, $DepthMap, $DepthMapState, Hash(rndState++), ssUV, ssAtt))
		{
			const vec3 ssColor = texture(sampler2D($SceneColor, $SceneColorState), ssUV).xyz;
			float w = Reservoir_CalculateProbability(ssColor);
			w = clamp(w, 0.0f, 4.0f);
			Reservoir_Update(
				reservoir,
				w,
				$Direction.xyz,
				$Depth,
				ssColor,
				Hash(rndState++)
			);
		}
		else
		{
			vec3 u, v;
			OrthogonalFrame($Direction.xyz, u, v);
			
			mat3 R = Rotate($Direction.xyz, Hash(rndState++) * TWO_PI);
			u = R * u;
			v = R * v;

			const int sampleN = (reservoir.M >= K) ? N : Ndisclose;
		
			for (int I = 0; I < sampleN; I += N)
			{
				vec3 Nacc = vec3(0.0f);
				for (int i = 0; i < N; ++i)
				{
					const float roughness = $Roughness;
					const vec2 jitter = vec2(Hash(rndState++), Hash(rndState++)) * 0.125f;

					const vec2 ruv = Hammersley(i, N) + jitter;
					const vec2 r = UniformDisc(roughness * roughness, ruv);
		
					const vec3 rayOrigin = $Origin.xyz;
					const vec3 rayDir = normalize($Direction.xyz + u * r.x + v * r.y);

					const float phi = 0.5f;
			
					HWRT_Material m;
					float t;
			
					if (HWRT_Trace($AS, rayOrigin, rayDir, Far, m, t))
					{
						const vec3 hit = rayOrigin + rayDir * t;
						const float attenuate = IndirectRangeFallOff(t);
						
						vec3 Tincident = vec3(0.0f);
						if (attenuate > 0.0f)
						{
							for (int lightIndex = 0; lightIndex < $LightCount; ++lightIndex)
							{
								const $typeof(Lights) light = $Lights[lightIndex];
								const vec4 incident = HWRT_Light_CalculateIncidentLight(
									$AS,
									$ViewInverse,
									light,
									hit,
									m.normal.xyz,
									false
								);
								Tincident += (incident.xyz * attenuate * phi * PI).xyz;
							}
						}

						Tincident += m.emissive * attenuate * phi * PI;

						Nacc += m.albedo * Tincident;
					}
					else
						Nacc += $Sky.xyz;
				}

				Nacc /= N;
			
				float w = Reservoir_CalculateProbability(Nacc);
				w = clamp(w, 0.0f, 4.0f);

				Reservoir_Update(
					reservoir,
					w,
					$Direction.xyz,
					$Depth,
					Nacc,
					Hash(rndState++)
				);
			}
		}
	}
	else
	{
		const float w = Reservoir_CalculateProbability($Sky.xyz);
		Reservoir_Update(
			reservoir,
			w,
			$Direction.xyz,
			$Depth,
			$Sky.xyz,
			Hash(rndState++)
		);
	}

	// Calculate lighting.
	vec4 acc = vec4(0.0f.xxx, 1.0f);
	if (!Reservoir_IsEmpty(reservoir))
		acc += vec4(Reservoir_GetRadiance(reservoir), 1.0f);

	imageStore($Output, pt, acc);

	$ReservoirOutput[index] = reservoir;
}

]]></script>
		</item>
