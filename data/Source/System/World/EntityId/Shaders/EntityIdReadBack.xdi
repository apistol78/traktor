			<outputPins/>
			<script><![CDATA[
// Copy entity id of a single texel into a read back slot.
const ivec2 pt = ivec2($Params.xy);
const int slot = int($Params.z);
$Buffer[slot].id = imageLoad($Input, pt).x;
]]></script>
