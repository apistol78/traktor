		<item type="traktor.render.Script" version="8,traktor.render.Node:1">
			<id>{559F8C73-142C-491E-86C1-B8508FA386A3}</id>
			<comment/>
			<position>
				<first>-506</first>
				<second>180</second>
			</position>
			<name>GTAO</name>
			<technique/>
			<domain>Undefined</domain>
			<localSize>
				<X>1</X>
				<Y>1</Y>
				<Z>1</Z>
			</localSize>
			<useRayTracing>false</useRayTracing>
			<include/>
			<inputPins>
				<item>
					<id>{1F52C315-635E-48F5-80F6-A9F732848B4A}</id>
					<name>UV</name>
				</item>
				<item>
					<id>{1BC49998-D0B9-4AF8-80B8-091DBCEE5ED3}</id>
					<name>DepthMap</name>
				</item>
				<item>
					<id>{543E8B76-A86E-4D20-8EC1-D1399D39F80D}</id>
					<name>DepthMapState</name>
				</item>
				<item>
					<id>{5CCBA565-7630-4BEB-B8B2-C3D198C6FF9B}</id>
					<name>Projection</name>
				</item>
				<item>
					<id>{A060293D-3562-4C63-BAAE-5BE710C75677}</id>
					<name>Random</name>
				</item>
				<item>
					<id>{C2018D9C-F56A-428F-A589-116EEF67A35F}</id>
					<name>Radius</name>
				</item>
				<item>
					<id>{DB409E1F-41DF-44C5-B4B7-743F43B5E374}</id>
					<name>FalloffRange</name>
				</item>
				<item>
					<id>{DF0BBECB-DA0D-4919-BF12-51907965AF4E}</id>
					<name>Bias</name>
				</item>
				<item>
					<id>{57ABE42A-9F02-4B33-9DEA-18E90DE3ED22}</id>
					<name>MaxRadiusPixels</name>
				</item>
				<item>
					<id>{DF53A75F-004C-47D3-8382-5731EE259A0C}</id>
					<name>Power</name>
				</item>
			</inputPins>
			<outputPins>
				<item>
					<id>{2A84E3D1-B618-411F-A7A6-5F3BD99D32E4}</id>
					<name>AO</name>
					<type>Scalar</type>
				</item>
			</outputPins>
			<script><![CDATA[// Ground truth ambient occlusion, Activision (Jimenez et al. 2016).
//
// Visibility is integrated over a number of slices through the view vector.
// Within each slice the horizon is searched in both directions and the
// cosine weighted visibility of the remaining arc is integrated
// analytically, which tracks a reference occlusion far closer than the
// hemisphere point sampling of the Alchemy estimator.
//
// $DepthMap is the half resolution GBuffer copy; view depth in R and the
// view space normal in GBA.

const int c_sliceCount = 4;
const int c_stepCount = 12;
const float c_pi = 3.14159265f;
const float c_halfPi = 1.57079633f;

const mat4 proj = $Projection;
const vec2 magicCoeffs = vec2(1.0f / proj[0][0], 1.0f / proj[1][1]);
const vec2 size = vec2(textureSize(sampler2D($DepthMap, $DepthMapState), 0));
const vec2 texelSize = 1.0f / size;

// Centre view position and normal.
const vec4 centre = texture(sampler2D($DepthMap, $DepthMapState), $UV);
const vec3 P = vec3((($UV * 2.0f - 1.0f) * vec2(1.0f, -1.0f) * magicCoeffs) * centre.x, centre.x);
const vec3 N = normalize(centre.yzw);
const vec3 V = normalize(-P);

// Origin nudged off the surface; the half resolution depth is minimum
// filtered, so an unbiased origin lets flat geometry shadow itself.
const vec3 O = P + N * $Bias;

// World space radius projected into pixels of the depth map; once the
// footprint collapses below a pixel there is nothing left to gather.
const float radiusPixels = min($Radius * proj[0][0] / max(centre.x, 0.001f) * size.x * 0.5f, $MaxRadiusPixels);

$AO = 1.0f;

if (radiusPixels >= 1.0f)
{
	const float falloffRange = max($FalloffRange, 0.01f) * $Radius;

	// 4x4 spatial dither of slice direction and step offset, rotated per frame.
	const ivec2 pixel = ivec2(gl_FragCoord.xy);
	const float noiseDirection = fract((1.0f / 16.0f) * float((((pixel.x + pixel.y) & 3) << 2) + (pixel.x & 3)) + $Random.x);
	const float noiseOffset = fract(0.25f * float((pixel.y - pixel.x) & 3) + $Random.y);

	float visibility = 0.0f;

	for (int i = 0; i < c_sliceCount; ++i)
	{
		const float phi = (float(i) + noiseDirection) * (c_pi / float(c_sliceCount));
		const vec2 direction = vec2(cos(phi), sin(phi));

		// The same direction in view space; the texture V axis points down.
		const vec3 sliceDirection = vec3(direction.x, -direction.y, 0.0f);
		const vec3 orthoDirection = sliceDirection - dot(sliceDirection, V) * V;
		const vec3 axis = normalize(cross(orthoDirection, V));

		// Normal projected into the slice plane, and its signed angle from V.
		const vec3 projectedNormal = N - axis * dot(N, axis);
		const float projectedNormalLength = length(projectedNormal);
		if (projectedNormalLength < 0.0001f)
			continue;

		const float cosN = clamp(dot(projectedNormal, V) / projectedNormalLength, -1.0f, 1.0f);
		const float signN = (dot(orthoDirection, projectedNormal) < 0.0f) ? -1.0f : 1.0f;
		const float n = signN * acos(cosN);

		// Horizon search along both halves of the slice.
		float horizonCosNegative = -1.0f;
		float horizonCosPositive = -1.0f;

		for (int j = 0; j < c_stepCount; ++j)
		{
			// A quadratic distribution concentrates samples near the centre.
			const float t = (float(j) + noiseOffset) / float(c_stepCount);
			const vec2 offset = direction * max(t * t * radiusPixels, 1.0f) * texelSize;

			const vec2 uvn = $UV - offset;
			const vec2 uvp = $UV + offset;

			const float zn = texture(sampler2D($DepthMap, $DepthMapState), uvn).x;
			const float zp = texture(sampler2D($DepthMap, $DepthMapState), uvp).x;

			const vec3 dn = vec3(((uvn * 2.0f - 1.0f) * vec2(1.0f, -1.0f) * magicCoeffs) * zn, zn) - O;
			const vec3 dp = vec3(((uvp * 2.0f - 1.0f) * vec2(1.0f, -1.0f) * magicCoeffs) * zp, zp) - O;

			const float ln = max(length(dn), 0.0001f);
			const float lp = max(length(dp), 0.0001f);

			// Fade an occluder out as it approaches the edge of the radius.
			const float wn = clamp(($Radius - ln) / falloffRange, 0.0f, 1.0f);
			const float wp = clamp(($Radius - lp) / falloffRange, 0.0f, 1.0f);

			horizonCosNegative = max(horizonCosNegative, mix(-1.0f, dot(dn, V) / ln, wn));
			horizonCosPositive = max(horizonCosPositive, mix(-1.0f, dot(dp, V) / lp, wp));
		}

		// Clamp both horizons into the hemisphere around the projected normal.
		const float h0 = n + max(-acos(clamp(horizonCosNegative, -1.0f, 1.0f)) - n, -c_halfPi);
		const float h1 = n + min(acos(clamp(horizonCosPositive, -1.0f, 1.0f)) - n, c_halfPi);
		const float sinN = sin(n);

		// Analytic integral of the cosine weighted visible arc, equation 7.
		const float arc0 = cosN + 2.0f * h0 * sinN - cos(2.0f * h0 - n);
		const float arc1 = cosN + 2.0f * h1 * sinN - cos(2.0f * h1 - n);

		visibility += projectedNormalLength * 0.25f * (arc0 + arc1);
	}

	$AO = pow(clamp(visibility / float(c_sliceCount), 0.0f, 1.0f), $Power);
}
]]></script>
		</item>
