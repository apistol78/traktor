		<item type="traktor.render.Script" version="8,traktor.render.Node:1">
			<id>{E66F63F1-6B3A-529E-8C4E-F11E71F8A304}</id>
			<comment/>
			<position>
				<first>923</first>
				<second>870</second>
			</position>
			<name>Composite</name>
			<technique/>
			<domain>Undefined</domain>
			<localSize>
				<X>1</X>
				<Y>1</Y>
				<Z>1</Z>
			</localSize>
			<useRayTracing>false</useRayTracing>
			<include/>
			<inputPins>
				<item>
					<id>{693EE02A-BB12-5D23-B117-4B8484350848}</id>
					<name>Albedo</name>
				</item>
				<item>
					<id>{8D9AF62B-447A-5FE1-8DDE-6BB2A4EC7750}</id>
					<name>Light</name>
				</item>
				<item>
					<id>{5FED703A-BD12-53FF-9BBF-0638F812E375}</id>
					<name>Ambient</name>
				</item>
				<item>
					<id>{C57D15C8-FB2F-5F43-A562-1A71FCAF549D}</id>
					<name>Emissive</name>
				</item>
			</inputPins>
			<outputPins>
				<item>
					<id>{989D460A-A521-592C-BE80-FFD4361EE575}</id>
					<name>Output</name>
					<type>Vector</type>
				</item>
			</outputPins>
			<script><![CDATA[$Output = vec4($Albedo.xyz * ($Light.xyz + $Ambient.xyz) + $Emissive.xyz, $Albedo.w);
]]></script>
		</item>
