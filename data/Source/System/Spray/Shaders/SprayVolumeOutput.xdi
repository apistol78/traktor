		<item type="traktor.render.Script" version="8,traktor.render.Node:1">
			<id>{4F2B036F-160D-5696-AB25-17D8D704243A}</id>
			<comment/>
			<position>
				<first>-612</first>
				<second>1012</second>
			</position>
			<name>IrradianceGridAmbient</name>
			<technique/>
			<domain>Undefined</domain>
			<localSize>
				<X>1</X>
				<Y>1</Y>
				<Z>1</Z>
			</localSize>
			<useRayTracing>false</useRayTracing>
			<include/>
			<inputPins>
				<item>
					<id>{374A3CC1-8856-527B-A5E5-837798B9D713}</id>
					<name>Grid</name>
				</item>
				<item>
					<id>{BEEEE2F8-1972-5E20-B774-7D1C122297A3}</id>
					<name>WorldPosition</name>
				</item>
				<item>
					<id>{162899CE-5293-50B6-9440-11DB1FED0850}</id>
					<name>GridBoundsMin</name>
				</item>
				<item>
					<id>{45309C5F-0519-5D08-BEF6-209356AE386C}</id>
					<name>GridBoundsMax</name>
				</item>
				<item>
					<id>{8394C12B-09DC-5365-9A0D-EE4E498C308F}</id>
					<name>GridSize</name>
				</item>
			</inputPins>
			<outputPins>
				<item>
					<id>{5E98E2B4-5F19-5829-9347-906FF9D8BDB2}</id>
					<name>Output</name>
					<type>Vector</type>
				</item>
			</outputPins>
			<script><![CDATA[// Band 0 of the irradiance grid, trilinear; the average radiance over the sphere,
// which is what an isotropic medium in-scatters.
const vec3 wp = $WorldPosition.xyz;
const vec3 mn = $GridBoundsMin.xyz;
const vec3 mx = $GridBoundsMax.xyz;
const vec3 gs = trunc($GridSize.xyz);

const vec3 t = clamp((wp - mn) / max(mx - mn, vec3(0.0001f)), vec3(0.0f), vec3(1.0f));
const vec3 p = t * max(gs - vec3(1.0f), vec3(0.0f));
const vec3 gp = trunc(p);
const vec3 f = fract(p);

const vec3 factors = vec3(gs.y * gs.z, gs.z, 1.0f);
const float base = dot(gp, factors);
const vec3 stride = (min(gp + vec3(1.0f), gs - vec3(1.0f)) - gp) * factors;

vec3 dc = vec3(0.0f);
for (int i = 0; i < 8; ++i)
{
	const vec3 o = vec3(float(i & 1), float((i >> 1) & 1), float((i >> 2) & 1));
	const vec3 wv = mix(vec3(1.0f) - f, f, o);
	const int j = int(base + dot(o, stride));
	dc += (wv.x * wv.y * wv.z) * vec3($Grid[j].shR0_3.x, $Grid[j].shG0_3.x, $Grid[j].shB0_3.x);
}

$Output = vec4(dc * 0.2820947917738781f, 0.0f);
]]></script>
		</item>
