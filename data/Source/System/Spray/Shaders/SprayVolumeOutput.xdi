		<item type="traktor.render.Script" version="8,traktor.render.Node:1">
			<id>{3CA309D7-BDF9-5E34-B88B-D9CEE059D8DE}</id>
			<comment/>
			<position>
				<first>1266</first>
				<second>192</second>
			</position>
			<name>PuffScatter</name>
			<technique/>
			<domain>Undefined</domain>
			<localSize>
				<X>1</X>
				<Y>1</Y>
				<Z>1</Z>
			</localSize>
			<useRayTracing>false</useRayTracing>
			<include/>
			<inputPins>
				<item>
					<id>{DD8FC3C7-91DA-5051-A40D-B7824837A4A5}</id>
					<name>Diffuse</name>
				</item>
				<item>
					<id>{93DA5CFF-4766-50B3-9D91-E78D96712A70}</id>
					<name>Direction</name>
				</item>
				<item>
					<id>{3617E151-52E8-5EB2-B508-994AEF1294C5}</id>
					<name>ViewPosition</name>
				</item>
				<item>
					<id>{A21697E9-F675-5198-BFF4-B5A57B0ACCC7}</id>
					<name>Normal</name>
				</item>
				<item>
					<id>{A53748C1-5FA4-5E8D-943C-84DB3E3019E4}</id>
					<name>Density</name>
				</item>
			</inputPins>
			<outputPins>
				<item>
					<id>{7A374C47-8EE2-5084-9FE2-BB468E505842}</id>
					<name>Output</name>
					<type>Vector</type>
				</item>
			</outputPins>
			<script><![CDATA[// Thin smoke scatters by a two lobe Henyey-Greenstein phase, dense smoke shades
// like a matte ball with a wrapped terminator; the puff's opacity blends them.
const float PI = 3.14159265f;
const float gF = 0.6f;
const float gB = -0.25f;
const float backward = 0.3f;
const float wrap = 0.6f;

const vec3 L = $Direction.xyz;
const float cosTheta = dot(L, normalize($ViewPosition.xyz));

const float ggF = gF * gF;
const float ggB = gB * gB;
const float pF = (1.0f - ggF) / (4.0f * PI * pow(max(1.0f + ggF - 2.0f * gF * cosTheta, 0.0001f), 1.5f));
const float pB = (1.0f - ggB) / (4.0f * PI * pow(max(1.0f + ggB - 2.0f * gB * cosTheta, 0.0001f), 1.5f));
const float thin = mix(pF, pB, backward);

const float thick = clamp((dot($Normal.xyz, L) + wrap) / (1.0f + wrap), 0.0f, 1.0f) / PI;

$Output = vec4($Diffuse.xyz * mix(thin, thick, clamp($Density, 0.0f, 1.0f)), 0.0f);
]]></script>
		</item>
