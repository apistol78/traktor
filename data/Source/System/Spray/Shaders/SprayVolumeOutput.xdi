		<item type="traktor.render.Script" version="8,traktor.render.Node:1">
			<id>{A840B868-24EF-5DA3-85CC-04D661571C2A}</id>
			<comment/>
			<position>
				<first>972</first>
				<second>275</second>
			</position>
			<name>PuffNormal</name>
			<technique/>
			<domain>Undefined</domain>
			<localSize>
				<X>1</X>
				<Y>1</Y>
				<Z>1</Z>
			</localSize>
			<useRayTracing>false</useRayTracing>
			<include/>
			<inputPins>
				<item>
					<id>{9E695ED4-E6BE-535C-906D-B8415AA420B0}</id>
					<name>Extent</name>
				</item>
			</inputPins>
			<outputPins>
				<item>
					<id>{BC95E2D9-FC78-50A1-AA8A-337CE72DE55E}</id>
					<name>Output</name>
					<type>Vector</type>
				</item>
			</outputPins>
			<script><![CDATA[// View space normal of a ball spanning the quad, bulging towards the camera.
const vec2 e = $Extent.xy;
const float z = sqrt(max(1.0f - dot(e, e), 0.0f));
$Output = vec4(normalize(vec3(e, -z - 1e-4f)), 0.0f);
]]></script>
		</item>
