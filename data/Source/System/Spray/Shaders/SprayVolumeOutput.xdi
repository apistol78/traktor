		</item>
		<item type="traktor.render.Script" version="8,traktor.render.Node:1">
			<id>{B6809D55-63EC-5FE6-8735-ADD522201DC3}</id>
			<comment/>
			<position>
				<first>52</first>
				<second>857</second>
			</position>
			<name>IrradianceFieldAmbient</name>
			<technique/>
			<domain>Undefined</domain>
			<localSize>
				<X>1</X>
				<Y>1</Y>
				<Z>1</Z>
			</localSize>
			<useRayTracing>false</useRayTracing>
			<include>
				<item>{F6048A61-5C30-204E-8ACC-D203978866C8}</item>
			</include>
			<inputPins>
				<item>
					<id>{F09CCF02-F65F-5F17-877C-B89F935D77B3}</id>
					<name>Field</name>
				</item>
				<item>
					<id>{4CF5B50A-AD1D-521E-AA97-EDEA124B554C}</id>
					<name>ViewInverse</name>
				</item>
				<item>
					<id>{83DDB658-AAD4-5CA3-AA8E-8EA0D08A8638}</id>
					<name>WorldPosition</name>
				</item>
				<item>
					<id>{58AF22F3-FC97-56BE-97CF-B1091A563EC4}</id>
					<name>Sky</name>
				</item>
			</inputPins>
			<outputPins>
				<item>
					<id>{AB5E4749-1A12-55A1-A531-25B32A4482CC}</id>
					<name>Output</name>
					<type>Vector</type>
				</item>
			</outputPins>
			<script><![CDATA[// Ray traced light bounced off the surroundings as radiance averaged over the sphere (their
// irradiance times an assumed albedo, over pi), plus the sky as far as it is open.
const float PI = 3.14159265f;
const float c_surroundingAlbedo = 0.5f;
const vec3 uv = IrradianceFieldUV($ViewInverse, $WorldPosition.xyz);
const bool inside = all(greaterThanEqual(uv, vec3(0.0f))) && all(lessThanEqual(uv, vec3(1.0f)));
const vec3 bounce = SampleIrradianceField($Field, $ViewInverse, $WorldPosition.xyz) * c_surroundingAlbedo / PI;
const float open = inside ? SampleSkyVisibility($Field, $ViewInverse, $WorldPosition.xyz) : 1.0f;
$Output = vec4(bounce + $Sky.xyz * open, 0.0f);
]]></script>
		</item>
		<item type="traktor.render.Branch" version="traktor.render.Node:1">
