<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.render.ShaderGraph" version="traktor.render.Graph:1">
	<nodes>
		<item type="traktor.render.Comment" version="traktor.render.Node:1">
			<id>{18988E2C-BD86-44EB-A52F-71E457E484E0}</id>
			<comment><![CDATA[

Transform vector by a quaternion, via a rotation matrix.

Drop in replacement for QuatTransform. Prefer this one whenever several vectors
are rotated by the same quaternion; the matrix is built once and shared, which
is a lot cheaper than a q * v * conj(q) sandwich per vector.

			]]></comment>
			<position>
				<first>-75</first>
				<second>148</second>
			</position>
		</item>
		<item type="traktor.render.InputPort" version="3,traktor.render.Node:1">
			<id>{D35CA76D-463D-4DFE-83C6-CEBB38A9D52D}</id>
			<comment/>
			<position>
				<first>-232</first>
				<second>291</second>
			</position>
			<name>Input</name>
			<optional>false</optional>
		</item>
		<item type="traktor.render.InputPort" version="3,traktor.render.Node:1">
			<id>{221F57A6-00D9-433E-8463-899A952C6A82}</id>
			<comment><![CDATA[

As quaternion

			]]></comment>
			<position>
				<first>-240</first>
				<second>365</second>
			</position>
			<name>Rotation</name>
			<optional>false</optional>
		</item>
		<item type="traktor.render.InputPort" version="3,traktor.render.Node:1">
			<id>{283C92E9-1536-4746-984F-45FC1FD05271}</id>
			<comment/>
