			<include/>
			<inputPins>
				<item>
					<id>{C809AF49-C9E0-E143-BBC6-68E6B72460E3}</id>
					<name>Incident</name>
				</item>
				<item>
					<id>{B6D9C4AE-6EE0-E34C-AAC7-5747634DDF9D}</id>
