					<type>Scalar</type>
				</item>
			</outputPins>
			<script><![CDATA[
			
const int mip = int(pow($Roughness, 1) * $Mips);
$Mip = clamp(mip, 0, int($Mips) - 1);

			
			]]></script>
		</item>
		<item type="traktor.render.Parameter" version="traktor.render.Node:1">
