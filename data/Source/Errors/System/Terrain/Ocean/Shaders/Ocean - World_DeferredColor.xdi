		<item type="traktor.render.Script" version="8,traktor.render.Node:1">
			<id>{9B390FE9-AD84-B246-A2CF-786A27C43DA1}</id>
			<comment/>
			<position>
				<first>119</first>
				<second>-453</second>
			</position>
			<name>World2Grid</name>
			<technique/>
			<domain>Undefined</domain>
			<localSize>
				<X>1</X>
				<Y>1</Y>
				<Z>1</Z>
			</localSize>
			<useRayTracing>false</useRayTracing>
			<include/>
			<inputPins>
				<item>
					<id>{E6DFFFA4-DE8E-AF4C-A693-370FEC7B0CE4}</id>
					<name>WorldPosition</name>
				</item>
				<item>
					<id>{882A9844-C6A9-BC47-98BB-03E343D22928}</id>
					<name>GridBoundsMin</name>
				</item>
				<item>
					<id>{5A0ABD99-B610-4A49-AAF1-BB23D3F77908}</id>
					<name>GridBoundsMax</name>
				</item>
				<item>
					<id>{4AD8958D-03B6-3D45-8656-9C6A8B9AB69A}</id>
					<name>GridSize</name>
				</item>
			</inputPins>
			<outputPins>
				<item>
					<id>{65BC9AB2-ADEF-0343-8EFB-2BB1E8480435}</id>
					<name>GridPosition</name>
					<type>Vector</type>
				</item>
				<item>
					<id>{E42E4979-E0A3-5944-A40E-5CF145DE1BE7}</id>
					<name>BlendFactors</name>
					<type>Vector</type>
				</item>
				<item>
					<id>{021ECFBE-FAE4-8A40-AAF5-195B24C465AC}</id>
					<name>GridWorldCenter</name>
					<type>Vector</type>
				</item>
			</outputPins>
			<script><![CDATA[
			
const vec3 wp = $WorldPosition.xyz;
const vec3 mn = $GridBoundsMin.xyz;
const vec3 mx = $GridBoundsMax.xyz;
const vec3 gs = $GridSize.xyz;

const vec3 t = clamp((wp - mn) / (mx - mn), vec3(0.0f), vec3(1.0f));
const vec3 p = t * gs;

$BlendFactors = vec4(fract(p), 0.0f);
$GridPosition = vec4(trunc(p), 0.0f);
$GridWorldCenter = vec4(mn + (mx - mn) * trunc(p) / gs, 1.0f);
			
			]]></script>
		</item>
