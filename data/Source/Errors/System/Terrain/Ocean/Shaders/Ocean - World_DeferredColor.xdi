		</item>
		<item type="traktor.render.Script" version="8,traktor.render.Node:1">
			<id>{CADA2E4A-41B7-4304-9D18-53331977D97D}</id>
			<comment/>
			<position>
				<first>-450</first>
				<second>120</second>
			</position>
			<name>ApplyFogVolume</name>
			<technique/>
			<domain>Undefined</domain>
			<localSize>
				<X>1</X>
				<Y>1</Y>
				<Z>1</Z>
			</localSize>
			<useRayTracing>false</useRayTracing>
			<include>
				<item>{328E6693-7B5B-5B4F-AC6B-987ECADAE330}</item>
			</include>
			<inputPins>
				<item>
					<id>{C9AB55AD-1383-4ACA-AD33-566292397756}</id>
					<name>Color</name>
				</item>
				<item>
					<id>{2A5A22B8-D7A9-4820-8E18-113215A482FE}</id>
					<name>ViewPosition</name>
				</item>
				<item>
					<id>{83A358B2-9508-4377-90FE-2D762D1BB2E3}</id>
					<name>Volume</name>
				</item>
				<item>
					<id>{FFBCEBBB-8673-4B0E-AFED-36F78B770A17}</id>
					<name>VolumeState</name>
				</item>
				<item>
					<id>{A1C653B9-F48D-49B0-AC3C-E21EAB71219B}</id>
					<name>FogVolumeRange</name>
				</item>
				<item>
					<id>{1FCD7890-1476-421D-AAB8-9DC7AD4C947D}</id>
					<name>MagicCoeffs</name>
				</item>
			</inputPins>
			<outputPins>
				<item>
					<id>{B1F47FF2-9D2F-453D-91D0-9F8C873611DD}</id>
					<name>Output</name>
					<type>Vector</type>
				</item>
			</outputPins>
			<script><![CDATA[// Apply the integrated fog volume.
//
// The integration pass has already walked each froxel column front to back, so
// a froxel holds the in-scattering accumulated from the camera to its depth
// together with the transmittance to that same depth. All that is left here is
// to locate this pixel's froxel and composite - one trilinear tap, where this
// used to loop up to a full slice count of 3D texture fetches per pixel in
// every shader that includes Fog.

const vec3 vp = $ViewPosition.xyz;

const ivec3 volumeSize = textureSize(sampler3D($Volume, $VolumeState), 0);
const float sliceCount = max(float(volumeSize.z), 1.0f);

VSFrustum vsf;
vsf.volumeSize = volumeSize;
vsf.magicCoeffs = $MagicCoeffs.xy;
vsf.nearZ = $FogVolumeRange.x;
vsf.farZ = $FogVolumeRange.y;

// The slice distribution lives in the module, so ask it rather than repeating
// the exponent here - a module's #define is consumed by the preprocessor while
// resolving that module and is not visible from a script that includes it, so
// only its functions can be relied on. ViewspaceToNDC clamps the depth
// fraction, which keeps a surface outside the volume from producing a NaN.
const vec3 ndc = ViewspaceToNDC(vsf, vec3(vp.xy, max(vp.z, 0.0001f)));

const vec2 uv = ndc.xy * vec2(0.5f, -0.5f) + vec2(0.5f, 0.5f);

// Slice n holds the integral through its FAR boundary, at fraction
// (n + 1) / sliceCount, while its texel centre sits at (n + 0.5) / sliceCount -
// hence stepping back half a texel. A surface past the volume clamps to the
// last slice, which is the fully integrated value, and that is exactly where
// the distance fog picks up.
const float w = clamp(ndc.z - 0.5f / sliceCount, 0.0f, 1.0f);

const vec4 fog = texture(sampler3D($Volume, $VolumeState), vec3(uv, w));

const vec3 inScattering = fog.rgb;
const float transmittance = clamp(fog.a, 0.0f, 1.0f);

$Output = vec4($Color.rgb * transmittance + inScattering, $Color.a);
]]></script>
		</item>
		<item type="traktor.render.Lerp" version="traktor.render.Node:1">
			<id>{B0ACA18B-A89F-C441-8580-F3699003E12F}</id>
			<comment/>
			<position>
				<first>1508</first>
				<second>-190</second>
			</position>
		</item>
		<item type="traktor.render.Parameter" version="traktor.render.Node:1">
			<id>{8CBF745E-1534-6E47-8DF4-BC72CE02A144}</id>
			<comment/>
			<position>
				<first>1183</first>
				<second>-168</second>
			</position>
			<parameterDeclaration>{2124EB5A-AA38-3C49-932B-48CDE7844EC6}</parameterDeclaration>
		</item>
		<item type="traktor.render.Script" version="8,traktor.render.Node:1">
			<id>{E0A9EAF2-632F-40D1-94E5-08FC04377201}</id>
			<comment/>
			<position>
				<first>1169</first>
				<second>-103</second>
			</position>
			<name>FogFactor</name>
			<technique/>
			<domain>Undefined</domain>
			<localSize>
				<X>1</X>
				<Y>1</Y>
				<Z>1</Z>
			</localSize>
			<useRayTracing>false</useRayTracing>
			<include/>
			<inputPins>
				<item>
					<id>{7EA62CDE-55A9-4838-AEB7-1A0C02143160}</id>
					<name>Distance</name>
				</item>
				<item>
					<id>{66EA8578-6EE5-45DA-83D6-AC81CB57A124}</id>
					<name>Density</name>
				</item>
			</inputPins>
			<outputPins>
				<item>
					<id>{6B6BADC6-F11B-42DA-B348-CFA90E59CCF7}</id>
					<name>Output</name>
					<type>Scalar</type>
				</item>
			</outputPins>
			<script><![CDATA[			
$Output = 1.0f - 1.0f / exp($Distance * $Density);
			]]></script>
		</item>
		<item type="traktor.render.Script" version="8,traktor.render.Node:1">
			<id>{A1BA704C-8BFA-418C-BF4F-95BEC47F5346}</id>
			<comment/>
			<position>
				<first>761</first>
				<second>-266</second>
			</position>
			<name>Intersect</name>
			<technique/>
			<domain>Undefined</domain>
			<localSize>
				<X>1</X>
				<Y>1</Y>
				<Z>1</Z>
			</localSize>
			<useRayTracing>false</useRayTracing>
			<include>
				<item>{6A9368D5-11D0-B54D-99B4-42A7BCE5A89C}</item>
			</include>
			<inputPins>
				<item>
					<id>{F13981A1-89AC-4108-B179-C1112AFEC0A0}</id>
					<name>ViewPosition</name>
				</item>
				<item>
					<id>{EFA84A34-47F8-4EF1-ACAC-A57AB42D1FD2}</id>
					<name>ViewInverse</name>
				</item>
				<item>
					<id>{B681FE29-04F7-4E8D-B71D-44019D9F450C}</id>
					<name>FogElevation</name>
				</item>
				<item>
					<id>{21FE2F04-3344-4B01-83B9-6BCE6033D639}</id>
					<name>View</name>
				</item>
				<item>
					<id>{AF62A0C7-8339-4D58-B0CE-52C00E71E1E7}</id>
					<name>StartDistance</name>
				</item>
			</inputPins>
			<outputPins>
				<item>
					<id>{41DA406A-9D77-45A8-A635-F858DDBD3792}</id>
					<name>Output</name>
					<type>Scalar</type>
				</item>
			</outputPins>
			<script><![CDATA[// Length of the ray that lies inside the fog slab - everything below
// FogElevation - restricted to the part beyond StartDistance.
//
// StartDistance is how the volumetric fog hands over. The froxel volume only
// reaches its own far plane, so the distance fog must account for what is left
// beyond that and nothing nearer, or the near range ends up fogged twice.
//
// Parameterise the ray as s in [0,1] from the camera to the surface. The slab
// is a half space, so the part of the ray inside it is one contiguous interval
// [sLo, sHi]; clipping the handover away is then just raising sLo.

const vec3 vp = $ViewPosition.xyz;
const float len = length(vp);

const vec4 worldOrigin = $ViewInverse[3];
const vec4 worldPosition = $ViewInverse * vec4(vp, 1.0f);

const float oy = worldOrigin.y;
const float py = worldPosition.y;

float sLo = 0.0f;
float sHi = 1.0f;

if (abs(py - oy) > 0.0001f)
{
	const float sE = ($FogElevation - oy) / (py - oy);
	if (py < oy)
		sLo = max(sE, 0.0f);	// Descending; inside from the crossing onwards.
	else
		sHi = min(sE, 1.0f);	// Ascending; inside up to the crossing.
}
else if (oy > $FogElevation)
	sHi = 0.0f;					// Level with the plane and above it.

sLo = max(sLo, $StartDistance / max(len, 0.0001f));

$Output = max(sHi - sLo, 0.0f) * len;
]]></script>
		</item>
		<item type="traktor.render.Swizzle" version="traktor.render.Node:1">
			<id>{54859C6E-0584-4D2B-8DAA-184D08C8F730}</id>
			<comment/>
			<position>
				<first>441</first>
				<second>-47</second>
			</position>
			<swizzle>w</swizzle>
		</item>
		<item type="traktor.render.Parameter" version="traktor.render.Node:1">
			<id>{FD5C2C12-DB17-4143-B487-51038EF66FB5}</id>
			<comment/>
			<position>
				<first>112</first>
				<second>-71</second>
			</position>
			<parameterDeclaration>{4EA758E3-4DD8-E940-8308-105A6AA76314}</parameterDeclaration>
		</item>
		<item type="traktor.render.Script" version="8,traktor.render.Node:1">
			<id>{E5750540-5799-491D-B6B3-03EB2D11BCB5}</id>
			<comment><![CDATA[Where the view ray leaves the volumetric fog volume.]]></comment>
			<position>
				<first>705</first>
				<second>929</second>
			</position>
			<name>VolumeFarDistance</name>
			<technique/>
			<domain>Undefined</domain>
			<localSize>
				<X>1</X>
				<Y>1</Y>
				<Z>1</Z>
			</localSize>
			<useRayTracing>false</useRayTracing>
			<include/>
			<inputPins>
				<item>
					<id>{F65E248D-A78D-4872-8006-94C0E7F2556C}</id>
					<name>ViewPosition</name>
				</item>
				<item>
					<id>{12299C96-2351-4ABC-98AD-CC41BEFBD06B}</id>
					<name>FogVolumeRange</name>
				</item>
			</inputPins>
			<outputPins>
				<item>
					<id>{303AAFB0-23C3-4C0A-A8F6-521F14A90CF9}</id>
					<name>Output</name>
					<type>Scalar</type>
				</item>
			</outputPins>
			<script><![CDATA[// Distance along the view ray at which it leaves the volumetric fog volume,
// which is where the distance fog has to take over.
//
// The volume's far bound is a plane at a constant view z, not a sphere, so the
// ray crosses it at farZ / D.z for a normalised ray direction D - equivalently
// farZ * len / vp.z. Clamped to the ray itself so that geometry inside the
// volume yields the whole ray and leaves nothing for the distance fog.

const vec3 vp = $ViewPosition.xyz;
const float len = length(vp);
const float farZ = $FogVolumeRange.y;

$Output = clamp(farZ * len / max(vp.z, 0.0001f), 0.0f, len);
]]></script>
		</item>
