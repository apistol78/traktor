			<comment/>
			<position>
				<first>6424</first>
				<second>547</second>
			</position>
			<name>Scatter</name>
			<technique/>
			<domain>Undefined</domain>
			<localSize>
				<X>1</X>
				<Y>1</Y>
				<Z>1</Z>
			</localSize>
			<useRayTracing>false</useRayTracing>
			<include>
				<item>{1513C77F-E3E4-FA44-B196-35713004CFD3}</item>
			</include>
			<inputPins>
				<item>
					<id>{2546AA51-1B48-8240-9656-50A53F4D6E3C}</id>
					<name>ViewNormal</name>
				</item>
				<item>
					<id>{2E13060A-ACB1-0846-A01B-186E6EFFA326}</id>
					<name>ViewLightDirection</name>
				</item>
				<item>
					<id>{72A7E1E4-DC74-4947-8C67-3A5B5D404735}</id>
					<name>HeightDisplacement</name>
				</item>
				<item>
					<id>{F1791840-F6FF-6941-8456-DAE441C38A38}</id>
					<name>ViewDirection</name>
				</item>
				<item>
					<id>{47B0CCED-0B27-2044-9195-085E87C614ED}</id>
					<name>Irradiance</name>
				</item>
				<item>
					<id>{9FE48CA2-62D8-864B-8DAA-FC28E5DF748D}</id>
					<name>ScatterColor</name>
				</item>
				<item>
					<id>{F2D3273A-0B58-CC4F-8A42-76D3BEC9605D}</id>
					<name>BubbleColor</name>
				</item>
				<item>
					<id>{1354F3D7-9B2F-8246-AD00-5EE2EC876207}</id>
					<name>SpecularCoeff</name>
				</item>
			</inputPins>
			<outputPins>
				<item>
					<id>{9484891E-0A02-5F4D-9D41-EC6C5FA7AF8A}</id>
					<name>Output</name>
					<type>Vector</type>
				</item>
			</outputPins>
			<script><![CDATA[
			
const vec3 scatter = ComputeOceanScattering(
	$HeightDisplacement.x * 200.0f,
	$ViewDirection.xyz,
	$ViewNormal.xyz,
	$ViewLightDirection.xyz,
	$Irradiance.xyz,
	$ScatterColor.xyz,
	$BubbleColor.xyz,
	$SpecularCoeff.xyz
);
$Output = vec4(scatter, 0.0f);
			
			]]></script>
		</item>
