<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.PropertyGroup">
	<value>
		<item>
			<first>Direct.Environment</first>
			<second type="traktor.PropertyGroup">
				<value/>
			</second>
		</item>
		<item>
			<first>Direct.Products</first>
			<second type="traktor.PropertyGroup">
				<value>
					<item>
						<first>StaticLibrary</first>
						<second type="traktor.PropertyString">
							<value>lib%(Name).a</value>
						</second>
					</item>
					<item>
						<first>SharedLibrary</first>
						<second type="traktor.PropertyString">
							<value>lib%(Name).so</value>
						</second>
					</item>
					<item>
						<first>Executable</first>
						<second type="traktor.PropertyString">
							<value>%(Name)</value>
						</second>
					</item>
					<item>
						<first>ExecutableConsole</first>
						<second type="traktor.PropertyString">
							<value>%(Name)</value>
						</second>
					</item>
				</value>
			</second>
		</item>
		<item>
			<first>Direct.Tools</first>
			<second type="traktor.PropertyGroup">
				<value>
					<item>
						<first>BinaryInclude</first>
						<second type="traktor.PropertyGroup">
							<value>
								<item>
									<first>Extensions</first>
									<second type="traktor.PropertyString">
										<value>cgf;cgv;css;exe;image;js;lua;png;xdi</value>
									</second>
								</item>
								<item>
									<first>Command</first>
									<second type="traktor.PropertyString">
										<value>$(TRAKTOR_HOME)/bin/%(Platform)/releasestatic/Traktor.Run.App $(TRAKTOR_HOME)/scripts/binaryinclude/BinaryInclude.run "%(Input)" "%(Output)" c_Resource%(FileName)</value>
									</second>
								</item>
								<item>
									<first>Output</first>
									<second type="traktor.PropertyString">
										<value>%(IntDir)/Resources/%(FileName).h</value>
									</second>
								</item>
							</value>
						</second>
					</item>
				</value>
			</second>
		</item>
	</value>
</object>
