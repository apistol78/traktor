{
    "version": "2.0.0",
	"tasks": [
		{
			"type": "shell",
			"label": "Platform - DebugShared",
			"group": "build",

			"linux": {
				"options": {
					"cwd": "${workspaceRoot}/.."
				},
				"command": "./bin/linux/releasestatic/Traktor.SolutionBuilder.App -f=direct -target=DebugShared resources/build/TraktorLinux.xms",
				"problemMatcher": [
					"$gcc"
				]
			},

			"osx": {
				"command": "${workspaceRoot}/../scripts/build-vscode.sh macOS DebugShared",
				"problemMatcher": [
					"$gcc"
				]
			},

			"windows": {
				"options": {
					"cwd": "${workspaceRoot}/..",
					"shell": { "executable": "cmd.exe", "args": [ "/d", "/c" ] }
				},
				"command": "call scripts\\config-vs-x64.bat && bin\\win64\\releasestatic\\Traktor.SolutionBuilder.App.exe -f=direct -target=DebugShared resources\\build\\TraktorWin64.xms",
				"problemMatcher": [
					"$msCompile"
				]			
			}
		},

