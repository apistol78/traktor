<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.sb.Solution" version="7">
	<name>Webber</name>
	<rootPath>$(TRAKTOR_HOME)/tools/Webber/build/win64</rootPath>
	<aggregateOutputPath>$(TRAKTOR_HOME)/bin/latest/win64</aggregateOutputPath>
	<projects>
		<item type="traktor.sb.Project" version="1">
			<enable>true</enable>
			<name>Webber</name>
			<sourcePath>$(TRAKTOR_HOME)/tools/Webber/code</sourcePath>
			<configurations>
				<item type="traktor.sb.Configuration" version="5">
					<name>DebugShared</name>
					<targetFormat>TfExecutableConsole</targetFormat>
					<targetProfile>TpDebug</targetProfile>
					<precompiledHeader/>
					<includePaths>
						<item>$(TRAKTOR_HOME)/code</item>
						<item>$(TRAKTOR_HOME)/tools/Webber/code</item>
					</includePaths>
					<definitions>
						<item>_DEBUG</item>
					</definitions>
					<libraryPaths/>
					<libraries/>
					<warningLevel>WlCompilerDefault</warningLevel>
					<additionalCompilerOptions>/utf-8</additionalCompilerOptions>
					<additionalLinkerOptions/>
					<debugExecutable/>
					<debugArguments/>
					<debugEnvironment>PATH=$(TRAKTOR_HOME)/bin/latest/win64/debugshared</debugEnvironment>
					<debugWorkingDirectory/>
					<aggregationItems>
						<item type="traktor.sb.AggregationItem">
							<sourceFile>Webber.exe</sourceFile>
							<targetPath>debugshared</targetPath>
						</item>
						<item type="traktor.sb.AggregationItem">
							<sourceFile>Webber.pdb</sourceFile>
							<targetPath>debugshared</targetPath>
						</item>
					</aggregationItems>
					<consumerLibraryPath/>
				</item>
				<item type="traktor.sb.Configuration" version="5">
					<name>ReleaseShared</name>
					<targetFormat>TfExecutableConsole</targetFormat>
					<targetProfile>TpRelease</targetProfile>
					<precompiledHeader/>
					<includePaths>
						<item>$(TRAKTOR_HOME)/code</item>
						<item>$(TRAKTOR_HOME)/tools/Webber/code</item>
					</includePaths>
					<definitions>
						<item>NDEBUG</item>
					</definitions>
					<libraryPaths/>
					<libraries/>
					<warningLevel>WlCompilerDefault</warningLevel>
					<additionalCompilerOptions>/utf-8</additionalCompilerOptions>
					<additionalLinkerOptions/>
					<debugExecutable/>
					<debugArguments/>
					<debugEnvironment>PATH=$(TRAKTOR_HOME)/bin/latest/win64/releaseshared</debugEnvironment>
					<debugWorkingDirectory/>
					<aggregationItems>
						<item type="traktor.sb.AggregationItem">
							<sourceFile>Webber.exe</sourceFile>
							<targetPath>releaseshared</targetPath>
						</item>
						<item type="traktor.sb.AggregationItem">
							<sourceFile>Webber.pdb</sourceFile>
							<targetPath>releaseshared</targetPath>
						</item>
					</aggregationItems>
					<consumerLibraryPath/>
				</item>
				<item type="traktor.sb.Configuration" version="5">
					<name>DebugStatic</name>
					<targetFormat>TfExecutableConsole</targetFormat>
					<targetProfile>TpDebug</targetProfile>
					<precompiledHeader/>
					<includePaths>
						<item>$(TRAKTOR_HOME)/code</item>
						<item>$(TRAKTOR_HOME)/tools/Webber/code</item>
					</includePaths>
					<definitions>
						<item>T_STATIC</item>
						<item>_DEBUG</item>
					</definitions>
					<libraryPaths/>
					<libraries/>
					<warningLevel>WlCompilerDefault</warningLevel>
					<additionalCompilerOptions>/utf-8</additionalCompilerOptions>
					<additionalLinkerOptions/>
					<debugExecutable/>
					<debugArguments/>
					<debugEnvironment/>
					<debugWorkingDirectory/>
					<aggregationItems>
						<item type="traktor.sb.AggregationItem">
							<sourceFile>Webber.exe</sourceFile>
							<targetPath>debugstatic</targetPath>
						</item>
						<item type="traktor.sb.AggregationItem">
							<sourceFile>Webber.pdb</sourceFile>
							<targetPath>debugstatic</targetPath>
						</item>
					</aggregationItems>
					<consumerLibraryPath/>
				</item>
				<item type="traktor.sb.Configuration" version="5">
					<name>ReleaseStatic</name>
					<targetFormat>TfExecutableConsole</targetFormat>
					<targetProfile>TpRelease</targetProfile>
					<precompiledHeader/>
					<includePaths>
						<item>$(TRAKTOR_HOME)/code</item>
						<item>$(TRAKTOR_HOME)/tools/Webber/code</item>
					</includePaths>
					<definitions>
						<item>T_STATIC</item>
						<item>NDEBUG</item>
					</definitions>
					<libraryPaths/>
					<libraries/>
					<warningLevel>WlCompilerDefault</warningLevel>
					<additionalCompilerOptions>/utf-8</additionalCompilerOptions>
					<additionalLinkerOptions/>
					<debugExecutable/>
					<debugArguments/>
					<debugEnvironment/>
					<debugWorkingDirectory/>
					<aggregationItems>
						<item type="traktor.sb.AggregationItem">
							<sourceFile>Webber.exe</sourceFile>
							<targetPath>releasestatic</targetPath>
						</item>
						<item type="traktor.sb.AggregationItem">
							<sourceFile>Webber.pdb</sourceFile>
							<targetPath>releasestatic</targetPath>
						</item>
					</aggregationItems>
					<consumerLibraryPath/>
				</item>
			</configurations>
			<items>
				<item type="traktor.sb.File" version="1">
					<fileName>*.*</fileName>
					<excludeFilter/>
					<items/>
				</item>
				<item type="traktor.sb.Filter">
					<name>Webber</name>
					<items>
						<item type="traktor.sb.File" version="1">
							<fileName>Webber/*.*</fileName>
							<excludeFilter/>
							<items/>
						</item>
						<item type="traktor.sb.Filter">
							<name>Resources</name>
							<items>
								<item type="traktor.sb.File" version="1">
									<fileName>Webber/Resources/*.*</fileName>
									<excludeFilter/>
									<items/>
								</item>
							</items>
						</item>
					</items>
				</item>
				<item type="traktor.sb.Filter">
					<name>Blog</name>
					<items>
						<item type="traktor.sb.File" version="1">
							<fileName>Blog/*.*</fileName>
							<excludeFilter/>
							<items/>
						</item>
					</items>
				</item>
				<item type="traktor.sb.Filter">
					<name>Demo</name>
					<items>
						<item type="traktor.sb.File" version="1">
							<fileName>Demo/*.*</fileName>
							<excludeFilter/>
							<items/>
						</item>
						<item type="traktor.sb.Filter">
							<name>Resources</name>
							<items>
								<item type="traktor.sb.File" version="1">
									<fileName>Demo/Resources/*.*</fileName>
									<excludeFilter/>
									<items/>
								</item>
							</items>
						</item>
					</items>
				</item>
				<item type="traktor.sb.Filter">
					<name>Forum</name>
					<items>
						<item type="traktor.sb.File" version="1">
							<fileName>Forum/*.*</fileName>
							<excludeFilter/>
							<items/>
						</item>
					</items>
				</item>
				<item type="traktor.sb.Filter">
					<name>Project</name>
					<items>
						<item type="traktor.sb.File" version="1">
							<fileName>Project/*.*</fileName>
							<excludeFilter/>
							<items/>
						</item>
					</items>
				</item>
			</items>
			<dependencies>
				<item type="traktor.sb.ExternalDependency" version="3">
					<inheritIncludePaths>true</inheritIncludePaths>
					<link>LnkYes</link>
					<solutionFileName>$(TRAKTOR_HOME)/resources/build/TraktorWin64.xms</solutionFileName>
					<projectName>Traktor.Core</projectName>
				</item>
				<item type="traktor.sb.ExternalDependency" version="3">
					<inheritIncludePaths>true</inheritIncludePaths>
					<link>LnkYes</link>
					<solutionFileName>$(TRAKTOR_HOME)/resources/build/TraktorWin64.xms</solutionFileName>
					<projectName>Traktor.Html</projectName>
				</item>
				<item type="traktor.sb.ExternalDependency" version="3">
					<inheritIncludePaths>true</inheritIncludePaths>
					<link>LnkYes</link>
					<solutionFileName>$(TRAKTOR_HOME)/resources/build/TraktorWin64.xms</solutionFileName>
					<projectName>Traktor.Net</projectName>
				</item>
				<item type="traktor.sb.ExternalDependency" version="3">
					<inheritIncludePaths>true</inheritIncludePaths>
					<link>LnkYes</link>
					<solutionFileName>$(TRAKTOR_HOME)/resources/build/TraktorWin64.xms</solutionFileName>
					<projectName>Traktor.Xml</projectName>
				</item>
			</dependencies>
		</item>
	</projects>
	<startupProject ref="/object/projects/item"/>
	<environmentVariables/>
</object>
